@model SistemaChotaExpress.Models.Encomienda
@{
    ViewData["Title"] = "Registrar Encomienda";
}

<style>
    .hour-pill-btn {
        border-radius: 20px !important;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 11px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .btn-glass-pill {
        background: rgba(255, 255, 255, 0.10);
        color: #e2e8f0;
        border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .btn-glass-pill:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }
    .payment-pill-btn {
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 8px 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.05);
        color: #cbd5e1;
    }
    .payment-pill-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
    }
    .payment-pill-btn.active-efectivo {
        background: #10b981 !important;
        color: #fff !important;
        border-color: #10b981 !important;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
    }
    .payment-pill-btn.active-yape {
        background: #7c3aed !important;
        color: #fff !important;
        border-color: #7c3aed !important;
        box-shadow: 0 0 12px rgba(124, 58, 237, 0.45);
    }
    .payment-pill-btn.active-plin {
        background: #0284c7 !important;
        color: #fff !important;
        border-color: #0284c7 !important;
        box-shadow: 0 0 12px rgba(2, 132, 199, 0.45);
    }
</style>

<div class="row mb-3">
    <div class="col-12">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a la lista
        </a>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h2 text-white fw-bold mb-0"><i class="fa-solid fa-box me-2 text-warning"></i>Registrar Encomienda</h1>
                <p class="text-muted mb-0">Registra remitente y destinatario con DNI y RUC habilitados, clave de entrega y pago Yape/Plin</p>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2 shadow-sm border border-warning">
                    <i class="fa-solid fa-hashtag me-1"></i>N° Encomienda: #@(ViewBag.SiguienteNumero ?? 1)
                </span>
            </div>
        </div>
    </div>
</div>

<form asp-action="Registrar" method="post" id="formEncomienda">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">

        <!-- REMITENTE (QUIEN ENVÍA) -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                    <h6 class="text-warning mb-0"><i class="fa-solid fa-user me-2"></i>Datos del Remitente (quien envía)</h6>
                    <span class="badge bg-secondary fs-9"><i class="fa-solid fa-bolt me-1 text-warning"></i>Autocompletado</span>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="DniRemitente" class="form-label text-muted small fw-bold">DNI (8 dígitos)</label>
                            <div class="input-group">
                                <input asp-for="DniRemitente" id="txtDniRemitente" class="form-control bg-secondary border-0 text-white"
                                       placeholder="Ej: 72345678" maxlength="8" autocomplete="off" />
                                <button type="button" id="btnBuscarDniRemitente" class="btn btn-warning fw-bold px-2" title="Buscar RENIEC">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="RucRemitente" class="form-label text-muted small fw-bold">RUC (11 dígitos, Opcional)</label>
                            <div class="input-group">
                                <input asp-for="RucRemitente" id="txtRucRemitente" class="form-control bg-secondary border-0 text-white"
                                       placeholder="Ej: 20601234567" maxlength="11" autocomplete="off" />
                                <button type="button" id="btnBuscarRucRemitente" class="btn btn-outline-warning fw-bold px-2" title="Buscar SUNAT">
                                    <i class="fa-solid fa-building"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="statusRemitente" class="small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="NombreRemitente" class="form-label text-muted small fw-bold">Nombre Completo / Razón Social <span class="text-danger">*</span></label>
                        <input asp-for="NombreRemitente" id="txtNombreRemitente" class="form-control bg-secondary border-0 text-white"
                               placeholder="Se completa automáticamente al buscar DNI o RUC" required />
                        <span asp-validation-for="NombreRemitente" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="TelefonoRemitente" class="form-label text-muted small fw-bold">Teléfono / Celular Remitente</label>
                        <input asp-for="TelefonoRemitente" class="form-control bg-secondary border-0 text-white" placeholder="Ej: 987654321 (opcional)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- DESTINATARIO (QUIEN RECIBE) -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                    <h6 class="text-info mb-0"><i class="fa-solid fa-user-check me-2"></i>Datos del Destinatario (quien recibe)</h6>
                    <span class="badge bg-secondary fs-9"><i class="fa-solid fa-bolt me-1 text-info"></i>Autocompletado</span>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="DniDestinatario" class="form-label text-muted small fw-bold">DNI (8 dígitos)</label>
                            <div class="input-group">
                                <input asp-for="DniDestinatario" id="txtDniDestinatario" class="form-control bg-secondary border-0 text-white"
                                       placeholder="Ej: 72345678" maxlength="8" autocomplete="off" />
                                <button type="button" id="btnBuscarDniDestinatario" class="btn btn-info fw-bold text-white px-2" title="Buscar RENIEC">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="RucDestinatario" class="form-label text-muted small fw-bold">RUC (11 dígitos, Opcional)</label>
                            <div class="input-group">
                                <input asp-for="RucDestinatario" id="txtRucDestinatario" class="form-control bg-secondary border-0 text-white"
                                       placeholder="Ej: 20601234567" maxlength="11" autocomplete="off" />
                                <button type="button" id="btnBuscarRucDestinatario" class="btn btn-outline-info fw-bold px-2" title="Buscar SUNAT">
                                    <i class="fa-solid fa-building"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="statusDestinatario" class="small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="NombreDestinatario" class="form-label text-muted small fw-bold">Nombre Completo / Razón Social <span class="text-danger">*</span></label>
                        <input asp-for="NombreDestinatario" id="txtNombreDestinatario" class="form-control bg-secondary border-0 text-white"
                               placeholder="Se completa automáticamente al buscar DNI o RUC" required />
                        <span asp-validation-for="NombreDestinatario" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="TelefonoDestinatario" class="form-label text-muted small fw-bold">Teléfono / Celular Destinatario</label>
                        <input asp-for="TelefonoDestinatario" class="form-control bg-secondary border-0 text-white" placeholder="Recomendado para contactar la entrega" />
                    </div>
                </div>
            </div>
        </div>

        <!-- DATOS DEL PAQUETE, PAGO Y SEGURIDAD -->
        <div class="col-12">
            <div class="card bg-dark border-glass">
                <div class="card-header bg-transparent border-secondary">
                    <h6 class="text-white mb-0"><i class="fa-solid fa-box-open me-2 text-warning"></i>Datos del Paquete, Pago y Seguridad</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        
                        <!-- Descripción -->
                        <div class="col-md-5">
                            <label asp-for="Descripcion" class="form-label text-muted small fw-bold">Descripción del Contenido <span class="text-danger">*</span></label>
                            <input asp-for="Descripcion" class="form-control bg-secondary border-0 text-white"
                                   placeholder="Ej: Ropa, documentos, repuestos, caja..." required />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <!-- Peso -->
                        <div class="col-md-2">
                            <label asp-for="PesoKg" class="form-label text-muted small fw-bold">Peso (kg)</label>
                            <div class="input-group">
                                <input asp-for="PesoKg" type="number" step="0.1" min="0.1"
                                       class="form-control bg-secondary border-0 text-white" placeholder="0.0" />
                                <span class="input-group-text bg-secondary border-0 text-muted">kg</span>
                            </div>
                        </div>

                        <!-- Precio -->
                        <div class="col-md-2">
                            <label asp-for="PrecioEnvio" class="form-label text-warning small fw-bold">Precio Envío (S/) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-0 text-muted">S/</span>
                                <input asp-for="PrecioEnvio" type="number" step="0.50" min="0.01"
                                       class="form-control bg-secondary border-0 text-white fw-bold fs-5 text-warning" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="PrecioEnvio" class="text-danger small"></span>
                        </div>

                        <!-- Método de Pago: Efectivo, Yape, Plin -->
                        <div class="col-md-3">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-money-bill-wave me-1"></i> Método de Pago</label>
                            <input type="hidden" asp-for="MetodoPago" id="txtMetodoPago" value="Efectivo" />
                            <div class="d-flex gap-2">
                                <button type="button" class="payment-pill-btn active-efectivo flex-grow-1 justify-content-center" onclick="seleccionarPago('Efectivo', this)">
                                    <i class="fa-solid fa-money-bill"></i> Efectivo
                                </button>
                                <button type="button" class="payment-pill-btn flex-grow-1 justify-content-center" onclick="seleccionarPago('Yape', this)">
                                    <i class="fa-solid fa-mobile-screen"></i> Yape
                                </button>
                                <button type="button" class="payment-pill-btn flex-grow-1 justify-content-center" onclick="seleccionarPago('Plin', this)">
                                    <i class="fa-solid fa-bolt"></i> Plin
                                </button>
                            </div>
                        </div>

                        <!-- Clave de Envío / Código de Recojo -->
                        <div class="col-md-4">
                            <label asp-for="ClaveEnvio" class="form-label text-info small fw-bold">
                                <i class="fa-solid fa-key me-1"></i> Clave de Envío (Para Recojo)
                            </label>
                            <div class="input-group">
                                <input asp-for="ClaveEnvio" id="txtClaveEnvio" class="form-control bg-secondary border-0 text-white font-monospace fw-bold"
                                       placeholder="Ej: 4821" maxlength="15" autocomplete="off" />
                                <button type="button" class="btn btn-outline-info fw-bold" onclick="generarClaveAleatoria()" title="Generar clave aleatoria">
                                    <i class="fa-solid fa-dice me-1"></i> Generar
                                </button>
                            </div>
                            <small class="text-muted fs-9">Código secreto que se solicitará al destinatario para entregar el paquete.</small>
                        </div>

                        <!-- Horario de Salida -->
                        <div class="col-md-4">
                            <label asp-for="TurnoSalida" class="form-label text-muted small fw-bold"><i class="fa-solid fa-clock me-1 text-warning"></i> Horario de Salida (Opcional)</label>
                            <select asp-for="TurnoSalida" id="TurnoSalida" class="form-select bg-secondary border-0 text-white">
                                <option value="">-- Sin horario específico --</option>
                                <option value="05:00">05:00 am</option>
                                <option value="06:00">06:00 am</option>
                                <option value="07:00">07:00 am</option>
                                <option value="08:00">08:00 am</option>
                                <option value="09:00">09:00 am</option>
                                <option value="10:00">10:00 am</option>
                                <option value="11:00">11:00 am</option>
                                <option value="12:00">12:00 pm (mediodía)</option>
                                <option value="13:00">01:00 pm</option>
                                <option value="14:00">02:00 pm</option>
                                <option value="15:00">03:00 pm</option>
                                <option value="16:00">04:00 pm</option>
                                <option value="17:00">05:00 pm</option>
                                <option value="18:00">06:00 pm</option>
                                <option value="19:00">07:00 pm</option>
                                <option value="20:00">08:00 pm</option>
                                <option value="21:00">09:00 pm</option>
                                <option value="22:00">10:00 pm</option>
                            </select>
                        </div>

                        <!-- Conductor / Chofer -->
                        <div class="col-md-4">
                            <label asp-for="NombreConductor" class="form-label text-muted small fw-bold"><i class="fa-solid fa-user-tie me-1 text-warning"></i> Conductor / Chofer (Opcional)</label>
                            <input asp-for="NombreConductor" class="form-control bg-secondary border-0 text-white" 
                                   placeholder="Nombre del chofer (opcional)" list="conductoresSugeridos" autocomplete="off" />
                            <datalist id="conductoresSugeridos">
                                @if (ViewBag.Conductores != null)
                                {
                                    foreach (string cond in (List<string>)ViewBag.Conductores)
                                    {
                                        <option value="@cond"></option>
                                    }
                                }
                            </datalist>
                        </div>

                        <!-- Origen y Destino -->
                        <div class="col-md-6">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-location-dot me-1"></i> Origen</label>
                            <select name="origenRuta" id="origenRutaSelect" class="form-select bg-secondary border-0 text-white" required>
                                <option value="">-- Seleccionar Origen --</option>
                                @if (ViewBag.Lugares != null)
                                {
                                    foreach (string l in (List<string>)ViewBag.Lugares)
                                    {
                                        var isSel = (Model?.ObjetoRuta?.Origen == l);
                                        <option value="@l" selected="@isSel">@l</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-map-pin me-1"></i> Destino</label>
                            <select name="destinoRuta" id="destinoRutaSelect" class="form-select bg-secondary border-0 text-white" required>
                                <option value="">-- Seleccionar Destino --</option>
                                @if (ViewBag.Lugares != null)
                                {
                                    foreach (string l in (List<string>)ViewBag.Lugares)
                                    {
                                        var isSel = (Model?.ObjetoRuta?.Destino == l);
                                        <option value="@l" selected="@isSel">@l</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Observaciones -->
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label text-muted small fw-bold">Observaciones / Indicaciones Especiales</label>
                            <textarea asp-for="Observaciones" rows="2"
                                      class="form-control bg-secondary border-0 text-white"
                                      placeholder="Frágil, urgente, mantener refrigerado... (opcional)"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTONES -->
        <div class="col-12 d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-warning fw-bold px-5">
                <i class="fa-solid fa-box me-2"></i>Registrar Encomienda
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Función para cambiar método de pago
        function seleccionarPago(metodo, btn) {
            document.getElementById('txtMetodoPago').value = metodo;
            document.querySelectorAll('.payment-pill-btn').forEach(b => {
                b.className = 'payment-pill-btn flex-grow-1 justify-content-center';
            });
            if (metodo === 'Efectivo') btn.classList.add('active-efectivo');
            if (metodo === 'Yape') btn.classList.add('active-yape');
            if (metodo === 'Plin') btn.classList.add('active-plin');
        }

        // Generar clave aleatoria de 4 dígitos
        function generarClaveAleatoria() {
            const aleatorio = Math.floor(1000 + Math.random() * 9000);
            document.getElementById('txtClaveEnvio').value = aleatorio;
        }

        // Búsqueda de documento (DNI 8 dígitos con RENIEC o RUC 11 dígitos con SUNAT)
        async function consultarDoc(tipo, inputId, nombreInputId, statusId, btnId) {
            const input = document.getElementById(inputId);
            const nombreInput = document.getElementById(nombreInputId);
            const statusDiv = document.getElementById(statusId);
            const btn = document.getElementById(btnId);

            const doc = input.value.trim();
            if (!doc) {
                statusDiv.innerHTML = `<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ingrese el ${tipo}.</span>`;
                return;
            }

            if (tipo === 'DNI' && doc.length !== 8) {
                statusDiv.innerHTML = '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> El DNI debe tener 8 dígitos.</span>';
                return;
            }
            if (tipo === 'RUC' && doc.length !== 11) {
                statusDiv.innerHTML = '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> El RUC debe tener 11 dígitos.</span>';
                return;
            }

            if (btn) btn.disabled = true;
            statusDiv.innerHTML = `<span class="text-info"><i class="fa-solid fa-spinner fa-spin me-1"></i> Consultando ${tipo}...</span>`;

            try {
                const response = await fetch(`/Documento/Consultar?tipo=${tipo}&numero=${doc}`);
                const data = await response.json();

                if (data.success && data.nombreCompleto) {
                    nombreInput.value = data.nombreCompleto;
                    const entidad = tipo === 'RUC' ? 'SUNAT' : 'RENIEC';
                    statusDiv.innerHTML = `<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Encontrado en ${entidad}: <strong>${data.nombreCompleto}</strong></span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-warning"><i class="fa-solid fa-circle-info me-1"></i> ${data.mensaje || 'No se encontró. Ingrese el nombre manualmente.'}</span>`;
                }
            } catch (err) {
                console.error("Error consultando documento:", err);
                statusDiv.innerHTML = '<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Error en la consulta. Puede ingresar el nombre manualmente.</span>';
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Autogenerar clave si está vacía
            const claveInput = document.getElementById('txtClaveEnvio');
            if (claveInput && !claveInput.value) {
                generarClaveAleatoria();
            }

            // Remitente - Eventos DNI y RUC
            document.getElementById('btnBuscarDniRemitente')?.addEventListener('click', () => {
                consultarDoc('DNI', 'txtDniRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarDniRemitente');
            });
            document.getElementById('txtDniRemitente')?.addEventListener('input', function() {
                if (this.value.trim().length === 8) {
                    consultarDoc('DNI', 'txtDniRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarDniRemitente');
                }
            });

            document.getElementById('btnBuscarRucRemitente')?.addEventListener('click', () => {
                consultarDoc('RUC', 'txtRucRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarRucRemitente');
            });
            document.getElementById('txtRucRemitente')?.addEventListener('input', function() {
                if (this.value.trim().length === 11) {
                    consultarDoc('RUC', 'txtRucRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarRucRemitente');
                }
            });

            // Destinatario - Eventos DNI y RUC
            document.getElementById('btnBuscarDniDestinatario')?.addEventListener('click', () => {
                consultarDoc('DNI', 'txtDniDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarDniDestinatario');
            });
            document.getElementById('txtDniDestinatario')?.addEventListener('input', function() {
                if (this.value.trim().length === 8) {
                    consultarDoc('DNI', 'txtDniDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarDniDestinatario');
                }
            });

            document.getElementById('btnBuscarRucDestinatario')?.addEventListener('click', () => {
                consultarDoc('RUC', 'txtRucDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarRucDestinatario');
            });
            document.getElementById('txtRucDestinatario')?.addEventListener('input', function() {
                if (this.value.trim().length === 11) {
                    consultarDoc('RUC', 'txtRucDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarRucDestinatario');
                }
            });
        });
    </script>
}
