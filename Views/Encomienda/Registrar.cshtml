@model SistemaChotaExpress.Models.Encomienda
@{
    ViewData["Title"] = "Registrar Encomienda";
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a la lista
        </a>
        <h1 class="h2 text-white fw-bold mb-0"><i class="fa-solid fa-box me-2 text-warning"></i>Registrar Encomienda</h1>
        <p class="text-muted">Completa los datos del paquete a enviar</p>
    </div>
</div>

<form asp-action="Registrar" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">

        <!-- REMITENTE -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary">
                    <h6 class="text-warning mb-0"><i class="fa-solid fa-user me-2"></i>Datos del Remitente (quien envia)</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="NombreRemitente" class="form-label text-muted small"></label>
                        <input asp-for="NombreRemitente" class="form-control bg-secondary border-0 text-white" placeholder="Nombre completo" />
                        <span asp-validation-for="NombreRemitente" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DniRemitente" class="form-label text-muted small"></label>
                        <input asp-for="DniRemitente" class="form-control bg-secondary border-0 text-white" placeholder="Opcional" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TelefonoRemitente" class="form-label text-muted small"></label>
                        <input asp-for="TelefonoRemitente" class="form-control bg-secondary border-0 text-white" placeholder="Opcional" />
                    </div>
                </div>
            </div>
        </div>

        <!-- DESTINATARIO -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary">
                    <h6 class="text-info mb-0"><i class="fa-solid fa-user-check me-2"></i>Datos del Destinatario (quien recibe)</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="NombreDestinatario" class="form-label text-muted small"></label>
                        <input asp-for="NombreDestinatario" class="form-control bg-secondary border-0 text-white" placeholder="Nombre completo" />
                        <span asp-validation-for="NombreDestinatario" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DniDestinatario" class="form-label text-muted small"></label>
                        <input asp-for="DniDestinatario" class="form-control bg-secondary border-0 text-white" placeholder="Opcional" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TelefonoDestinatario" class="form-label text-muted small"></label>
                        <input asp-for="TelefonoDestinatario" class="form-control bg-secondary border-0 text-white" placeholder="Recomendado para contactar" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PAQUETE Y RUTA -->
        <div class="col-12">
            <div class="card bg-dark border-glass">
                <div class="card-header bg-transparent border-secondary">
                    <h6 class="text-white mb-0"><i class="fa-solid fa-box-open me-2"></i>Datos del Paquete</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Descripcion" class="form-label text-muted small"></label>
                            <input asp-for="Descripcion" class="form-control bg-secondary border-0 text-white"
                                   placeholder="Ej: Ropa, documentos, electrodomestico..." />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PesoKg" class="form-label text-muted small"></label>
                            <div class="input-group">
                                <input asp-for="PesoKg" type="number" step="0.1" min="0.1"
                                       class="form-control bg-secondary border-0 text-white" placeholder="0.0" />
                                <span class="input-group-text bg-secondary border-0 text-muted">kg</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrecioEnvio" class="form-label text-muted small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-0 text-muted">S/</span>
                                <input asp-for="PrecioEnvio" type="number" step="0.50" min="0"
                                       class="form-control bg-secondary border-0 text-white" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PrecioEnvio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Id_Ruta" class="form-label text-muted small">Ruta de envio</label>
                            <select asp-for="Id_Ruta" asp-items="ViewBag.Rutas"
                                    class="form-select bg-secondary border-0 text-white">
                                <option value="">-- Seleccionar ruta --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label text-muted small"></label>
                            <textarea asp-for="Observaciones" rows="2"
                                      class="form-control bg-secondary border-0 text-white"
                                      placeholder="Fragil, urgente, mantener frio... (opcional)"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTONES -->
        <div class="col-12 d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-warning fw-bold px-5">
                <i class="fa-solid fa-box me-2"></i>Registrar Encomienda
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
