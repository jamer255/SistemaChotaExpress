@model SistemaChotaExpress.Models.Encomienda
@{
    ViewData["Title"] = "Editar Encomienda";
}

<style>
    .hour-pill-btn {
        border-radius: 20px !important;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 11px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .btn-glass-pill {
        background: rgba(255, 255, 255, 0.10);
        color: #e2e8f0;
        border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .btn-glass-pill:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }
    .btn-teal-active {
        background: #10b981 !important;
        color: #ffffff !important;
        border-color: #10b981 !important;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.45);
    }
</style>

<div class="row mb-3">
    <div class="col-12">
        <a asp-action="Detalle" asp-route-id="@Model.Id_Encomienda" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver al detalle
        </a>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h2 text-white fw-bold mb-0"><i class="fa-solid fa-pen me-2 text-warning"></i>Editar Encomienda</h1>
                <p class="text-muted mb-0">Código: <strong class="text-warning">@Model.CodigoSeguimiento</strong> — Solo disponible en estado <span class="badge bg-secondary">Registrado</span></p>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2 shadow-sm border border-warning">
                    <i class="fa-solid fa-hashtag me-1"></i>Encomienda #@Model.Id_Encomienda
                </span>
            </div>
        </div>
    </div>
</div>

<!-- BARRA DE HORARIOS DISPONIBLES (24 FRANJAS HORARIAS) -->
<div class="card bg-dark text-white border-glass p-3 mb-4 shadow-sm">
    <div class="sidebar-section-title mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-warning fw-bold fs-7">
            <i class="fa-regular fa-clock me-1 text-warning"></i> HORARIOS DISPONIBLES: <span id="franjaRutaTexto" class="text-white text-uppercase">@(Model.ObjetoRuta != null ? $"{Model.ObjetoRuta.Origen} → {Model.ObjetoRuta.Destino}" : "CHOTA → CAJAMARCA")</span>
        </span>
        <small class="text-muted fs-9">24 FRANJAS HORARIAS</small>
    </div>
    <div class="d-flex flex-wrap gap-1.5 hour-container" id="franjasHorariasContainer">
        @{
            string[] horas24 = new string[] {
                "00:00", "01:00", "02:00", "03:00", "04:00", "05:00",
                "06:00", "07:00", "08:00", "09:00", "10:00", "11:00",
                "12:00", "13:00", "14:00", "15:00", "16:00", "17:00",
                "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"
            };
            string[] horasLabels = new string[] {
                "12:00 AM", "01:00 AM", "02:00 AM", "03:00 AM", "04:00 AM", "05:00 AM",
                "06:00 AM", "07:00 AM", "08:00 AM", "09:00 AM", "10:00 AM", "11:00 AM",
                "12:00 PM", "01:00 PM", "02:00 PM", "03:00 PM", "04:00 PM", "05:00 PM",
                "06:00 PM", "07:00 PM", "08:00 PM", "09:00 PM", "10:00 PM", "11:00 PM"
            };
        }
        @for (int i = 0; i < 24; i++)
        {
            var hVal = horas24[i];
            var hLabel = horasLabels[i];
            var isSel = (Model?.TurnoSalida == hVal);
            <button type="button" 
                    class="btn hour-pill-btn mb-1 me-1 @(isSel ? "btn-teal-active shadow-lg" : "btn-glass-pill")" 
                    data-hora="@hVal" 
                    onclick="seleccionarHorarioTurno('@hVal', this)">
                <i class="fa-regular fa-clock me-1 fs-9"></i>@hLabel
            </button>
        }
    </div>
</div>

<form asp-action="Editar" asp-route-id="@Model.Id_Encomienda" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id_Encomienda" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">

        <!-- REMITENTE -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                    <h6 class="text-warning mb-0"><i class="fa-solid fa-user me-2"></i>Datos del Remitente (quien envía)</h6>
                    <span class="badge bg-secondary fs-9"><i class="fa-solid fa-bolt me-1 text-warning"></i>Autocompletado</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="DniRemitente" class="form-label text-muted small">DNI (8 dígitos) o RUC (11 dígitos)</label>
                        <div class="input-group">
                            <input asp-for="DniRemitente" id="txtDniRemitente" class="form-control bg-secondary border-0 text-white"
                                   placeholder="Ej: 72345678 o 20601234567" maxlength="11" autocomplete="off" />
                            <button type="button" id="btnBuscarRemitente" class="btn btn-warning fw-bold px-3">
                                <span id="txtBtnRemitente"><i class="fa-solid fa-magnifying-glass me-1"></i> Buscar</span>
                                <span id="spinnerRemitente" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </div>
                        <div id="statusRemitente" class="small mt-1"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NombreRemitente" class="form-label text-muted small">Nombre Completo / Razón Social <span class="text-danger">*</span></label>
                        <input asp-for="NombreRemitente" id="txtNombreRemitente" class="form-control bg-secondary border-0 text-white"
                               placeholder="Se completa automáticamente al ingresar DNI o RUC" />
                        <span asp-validation-for="NombreRemitente" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TelefonoRemitente" class="form-label text-muted small">Teléfono / Celular</label>
                        <input asp-for="TelefonoRemitente" class="form-control bg-secondary border-0 text-white" placeholder="Ej: 987654321 (opcional)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- DESTINATARIO -->
        <div class="col-md-6">
            <div class="card bg-dark border-glass h-100">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                    <h6 class="text-info mb-0"><i class="fa-solid fa-user-check me-2"></i>Datos del Destinatario (quien recibe)</h6>
                    <span class="badge bg-secondary fs-9"><i class="fa-solid fa-bolt me-1 text-info"></i>Autocompletado</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="DniDestinatario" class="form-label text-muted small">DNI (8 dígitos) o RUC (11 dígitos)</label>
                        <div class="input-group">
                            <input asp-for="DniDestinatario" id="txtDniDestinatario" class="form-control bg-secondary border-0 text-white"
                                   placeholder="Ej: 72345678 o 20601234567" maxlength="11" autocomplete="off" />
                            <button type="button" id="btnBuscarDestinatario" class="btn btn-info fw-bold text-white px-3">
                                <span id="txtBtnDestinatario"><i class="fa-solid fa-magnifying-glass me-1"></i> Buscar</span>
                                <span id="spinnerDestinatario" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </div>
                        <div id="statusDestinatario" class="small mt-1"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NombreDestinatario" class="form-label text-muted small">Nombre Completo / Razón Social <span class="text-danger">*</span></label>
                        <input asp-for="NombreDestinatario" id="txtNombreDestinatario" class="form-control bg-secondary border-0 text-white"
                               placeholder="Se completa automáticamente al ingresar DNI o RUC" />
                        <span asp-validation-for="NombreDestinatario" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TelefonoDestinatario" class="form-label text-muted small">Teléfono / Celular</label>
                        <input asp-for="TelefonoDestinatario" class="form-control bg-secondary border-0 text-white" placeholder="Recomendado para contactar" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PAQUETE Y RUTA -->
        <div class="col-12">
            <div class="card bg-dark border-glass">
                <div class="card-header bg-transparent border-secondary">
                    <h6 class="text-white mb-0"><i class="fa-solid fa-box-open me-2"></i>Datos del Paquete</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Descripcion" class="form-label text-muted small"></label>
                            <input asp-for="Descripcion" class="form-control bg-secondary border-0 text-white"
                                   placeholder="Ej: Ropa, documentos, electrodoméstico..." />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PesoKg" class="form-label text-muted small"></label>
                            <div class="input-group">
                                <input asp-for="PesoKg" type="number" step="0.1" min="0.1"
                                       class="form-control bg-secondary border-0 text-white" placeholder="0.0" />
                                <span class="input-group-text bg-secondary border-0 text-muted">kg</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrecioEnvio" class="form-label text-muted small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-0 text-muted">S/</span>
                                <input asp-for="PrecioEnvio" type="number" step="0.50" min="0.01"
                                       class="form-control bg-secondary border-0 text-white" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PrecioEnvio" class="text-danger small"></span>
                        </div>
                        <!-- Cuadrito opcional: Horario de Salida -->
                        <div class="col-md-3">
                            <label asp-for="TurnoSalida" class="form-label text-muted small"><i class="fa-solid fa-clock me-1 text-warning"></i> Horario de Salida <span class="text-muted">(Opcional)</span></label>
                            <select asp-for="TurnoSalida" id="TurnoSalida" class="form-select bg-secondary border-0 text-white">
                                <option value="">-- Sin horario (Opcional) --</option>
                                <option value="00:00">12:00 am (medianoche)</option>
                                <option value="01:00">01:00 am</option>
                                <option value="02:00">02:00 am</option>
                                <option value="03:00">03:00 am</option>
                                <option value="04:00">04:00 am</option>
                                <option value="05:00">05:00 am</option>
                                <option value="06:00">06:00 am</option>
                                <option value="07:00">07:00 am</option>
                                <option value="08:00">08:00 am</option>
                                <option value="09:00">09:00 am</option>
                                <option value="10:00">10:00 am</option>
                                <option value="11:00">11:00 am</option>
                                <option value="12:00">12:00 pm (mediodía)</option>
                                <option value="13:00">01:00 pm</option>
                                <option value="14:00">02:00 pm</option>
                                <option value="15:00">03:00 pm</option>
                                <option value="16:00">04:00 pm</option>
                                <option value="17:00">05:00 pm</option>
                                <option value="18:00">06:00 pm</option>
                                <option value="19:00">07:00 pm</option>
                                <option value="20:00">08:00 pm</option>
                                <option value="21:00">09:00 pm</option>
                                <option value="22:00">10:00 pm</option>
                                <option value="23:00">11:00 pm</option>
                            </select>
                        </div>
                        <!-- Cuadrito opcional: Conductor que lleva la encomienda -->
                        <div class="col-md-3">
                            <label asp-for="NombreConductor" class="form-label text-muted small"><i class="fa-solid fa-user-tie me-1 text-warning"></i> Conductor / Chofer <span class="text-muted">(Opcional)</span></label>
                            <input asp-for="NombreConductor" class="form-control bg-secondary border-0 text-white" 
                                   placeholder="Nombre del chofer (opcional)" list="conductoresSugeridos" autocomplete="off" />
                            <datalist id="conductoresSugeridos">
                                @if (ViewBag.Conductores != null)
                                {
                                    foreach (string cond in (List<string>)ViewBag.Conductores)
                                    {
                                        <option value="@cond"></option>
                                    }
                                }
                            </datalist>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-location-dot me-1"></i> Origen</label>
                            <select name="origenRuta" id="origenRutaSelect" class="form-select bg-secondary border-0 text-white" required>
                                <option value="">-- Seleccionar Origen --</option>
                                @if (ViewBag.Lugares != null)
                                {
                                    foreach (string l in (List<string>)ViewBag.Lugares)
                                    {
                                        var isSel = (Model.ObjetoRuta?.Origen == l);
                                        <option value="@l" selected="@isSel">@l</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-map-pin me-1"></i> Destino</label>
                            <select name="destinoRuta" id="destinoRutaSelect" class="form-select bg-secondary border-0 text-white" required>
                                <option value="">-- Seleccionar Destino --</option>
                                @if (ViewBag.Lugares != null)
                                {
                                    foreach (string l in (List<string>)ViewBag.Lugares)
                                    {
                                        var isSel = (Model.ObjetoRuta?.Destino == l);
                                        <option value="@l" selected="@isSel">@l</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label text-muted small"></label>
                            <textarea asp-for="Observaciones" rows="2"
                                      class="form-control bg-secondary border-0 text-white"
                                      placeholder="Frágil, urgente, mantener frío... (opcional)"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTONES -->
        <div class="col-12 d-flex gap-2 justify-content-end">
            <a asp-action="Detalle" asp-route-id="@Model.Id_Encomienda" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-warning fw-bold px-5">
                <i class="fa-solid fa-floppy-disk me-2"></i>Guardar Cambios
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        async function buscarDocumento(docInputId, nombreInputId, statusId, btnId, spinnerId, txtBtnId) {
            const docInput = document.getElementById(docInputId);
            const nombreInput = document.getElementById(nombreInputId);
            const statusDiv = document.getElementById(statusId);
            const btn = document.getElementById(btnId);
            const spinner = document.getElementById(spinnerId);
            const txtBtn = document.getElementById(txtBtnId);

            const doc = docInput.value.trim();
            if (!doc) {
                statusDiv.innerHTML = '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ingrese un DNI (8 dígitos) o RUC (11 dígitos).</span>';
                return;
            }

            let tipo = "";
            if (doc.length === 8) {
                tipo = "DNI";
            } else if (doc.length === 11) {
                tipo = "RUC";
            } else {
                statusDiv.innerHTML = '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> El documento debe tener 8 dígitos (DNI) o 11 dígitos (RUC).</span>';
                return;
            }

            // Estado cargando
            if (spinner) spinner.classList.remove("d-none");
            if (txtBtn) txtBtn.classList.add("d-none");
            if (btn) btn.disabled = true;
            statusDiv.innerHTML = `<span class="text-info"><i class="fa-solid fa-spinner fa-spin me-1"></i> Consultando ${tipo}...</span>`;

            try {
                const response = await fetch(`/Documento/Consultar?tipo=${tipo}&numero=${doc}`);
                const data = await response.json();

                if (data.success && data.nombreCompleto) {
                    nombreInput.value = data.nombreCompleto;
                    const entidad = tipo === 'RUC' ? 'SUNAT' : 'RENIEC';
                    statusDiv.innerHTML = `<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Encontrado en ${entidad}: <strong>${data.nombreCompleto}</strong></span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-warning"><i class="fa-solid fa-circle-info me-1"></i> ${data.mensaje || 'No se encontraron datos automáticos. Complete el nombre manualmente.'}</span>`;
                }
            } catch (err) {
                console.error("Error consultando documento:", err);
                statusDiv.innerHTML = '<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Error en la consulta. Puede ingresar el nombre de forma manual.</span>';
            } finally {
                if (spinner) spinner.classList.add("d-none");
                if (txtBtn) txtBtn.classList.remove("d-none");
                if (btn) btn.disabled = false;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Remitente - Autoconsulta
            let timerRemitente = null;
            const inputRemitente = document.getElementById('txtDniRemitente');
            inputRemitente?.addEventListener('input', function () {
                const val = this.value.trim();
                clearTimeout(timerRemitente);
                if (val.length === 8 || val.length === 11) {
                    timerRemitente = setTimeout(() => {
                        buscarDocumento('txtDniRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarRemitente', 'spinnerRemitente', 'txtBtnRemitente');
                    }, 400);
                }
            });

            document.getElementById('btnBuscarRemitente')?.addEventListener('click', function () {
                buscarDocumento('txtDniRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarRemitente', 'spinnerRemitente', 'txtBtnRemitente');
            });

            inputRemitente?.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    buscarDocumento('txtDniRemitente', 'txtNombreRemitente', 'statusRemitente', 'btnBuscarRemitente', 'spinnerRemitente', 'txtBtnRemitente');
                }
            });

            // Destinatario - Autoconsulta
            let timerDestinatario = null;
            const inputDestinatario = document.getElementById('txtDniDestinatario');
            inputDestinatario?.addEventListener('input', function () {
                const val = this.value.trim();
                clearTimeout(timerDestinatario);
                if (val.length === 8 || val.length === 11) {
                    timerDestinatario = setTimeout(() => {
                        buscarDocumento('txtDniDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarDestinatario', 'spinnerDestinatario', 'txtBtnDestinatario');
                    }, 400);
                }
            });

            document.getElementById('btnBuscarDestinatario')?.addEventListener('click', function () {
                buscarDocumento('txtDniDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarDestinatario', 'spinnerDestinatario', 'txtBtnDestinatario');
            });

            inputDestinatario?.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    buscarDocumento('txtDniDestinatario', 'txtNombreDestinatario', 'statusDestinatario', 'btnBuscarDestinatario', 'spinnerDestinatario', 'txtBtnDestinatario');
                }
            });

            // Sincronización de Franjas Horarias con el Select de Turno
            const selectTurno = document.getElementById('TurnoSalida');
            if (selectTurno) {
                selectTurno.addEventListener('change', function () {
                    const horaSeleccionada = this.value;
                    document.querySelectorAll('#franjasHorariasContainer .hour-pill-btn').forEach(btn => {
                        if (btn.getAttribute('data-hora') === horaSeleccionada) {
                            btn.classList.remove('btn-glass-pill');
                            btn.classList.add('btn-teal-active', 'shadow-lg');
                        } else {
                            btn.classList.remove('btn-teal-active', 'shadow-lg');
                            btn.classList.add('btn-glass-pill');
                        }
                    });
                });
            }

            // Actualización dinámica de Origen → Destino en la barra de horarios
            function actualizarTextoRutaFranja() {
                const origenSelect = document.getElementById('origenRutaSelect');
                const destinoSelect = document.getElementById('destinoRutaSelect');
                const spanTexto = document.getElementById('franjaRutaTexto');
                if (spanTexto) {
                    const orig = origenSelect && origenSelect.value ? origenSelect.value : 'CHOTA';
                    const dest = destinoSelect && destinoSelect.value ? destinoSelect.value : 'CAJAMARCA';
                    spanTexto.innerText = `${orig} → ${dest}`.toUpperCase();
                }
            }

            document.getElementById('origenRutaSelect')?.addEventListener('change', actualizarTextoRutaFranja);
            document.getElementById('destinoRutaSelect')?.addEventListener('change', actualizarTextoRutaFranja);
        });

        function seleccionarHorarioTurno(hora, btn) {
            const select = document.getElementById('TurnoSalida');
            if (select) {
                select.value = hora;
                select.dispatchEvent(new Event('change'));
            }
            document.querySelectorAll('#franjasHorariasContainer .hour-pill-btn').forEach(el => {
                el.classList.remove('btn-teal-active', 'shadow-lg');
                el.classList.add('btn-glass-pill');
            });
            if (btn) {
                btn.classList.remove('btn-glass-pill');
                btn.classList.add('btn-teal-active', 'shadow-lg');
            }
        }
    </script>
}
