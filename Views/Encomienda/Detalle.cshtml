@model SistemaChotaExpress.Models.Encomienda
@{
    ViewData["Title"] = "Detalle Encomienda";
    var badgeColor = Model.Estado switch {
        "Registrado"   => "bg-secondary",
        "En transito"  => "bg-info text-dark",
        "Entregado"    => "bg-success",
        "No reclamado" => "bg-danger",
        "Anulado"      => "bg-dark border border-secondary",
        _ => "bg-secondary"
    };
    bool puedeModificar = Model.Estado != "Entregado" && Model.Estado != "Anulado";
}

<div class="row mb-3 no-print">
    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver
        </a>
        <div class="d-flex gap-2 flex-wrap">
            <button onclick="window.print()" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-print me-1"></i> Imprimir comprobante
            </button>

            @if (puedeModificar)
            {
                @* Editar solo en estado Registrado *@
                @if (Model.Estado == "Registrado")
                {
                    <a asp-action="Editar" asp-route-id="@Model.Id_Encomienda" class="btn btn-outline-warning btn-sm fw-bold">
                        <i class="fa-solid fa-pen me-1"></i> Editar
                    </a>
                }

                @* Botones de cambio de estado *@
                @if (Model.Estado == "Registrado")
                {
                    <form asp-action="CambiarEstado" method="post" class="m-0 d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id_Encomienda" />
                        <input type="hidden" name="nuevoEstado" value="En transito" />
                        <button type="submit" class="btn btn-info btn-sm fw-bold text-dark"
                                onclick="return confirm('¿Marcar esta encomienda como En tránsito?')">
                            <i class="fa-solid fa-truck-fast me-1"></i> Marcar En tránsito
                        </button>
                    </form>
                }

                @if (Model.Estado == "Registrado" || Model.Estado == "En transito")
                {
                    <form asp-action="CambiarEstado" method="post" class="m-0 d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id_Encomienda" />
                        <input type="hidden" name="nuevoEstado" value="Entregado" />
                        <button type="submit" class="btn btn-success btn-sm fw-bold"
                                onclick="return confirm('¿Confirmar entrega de la encomienda?')">
                            <i class="fa-solid fa-circle-check me-1"></i> Marcar Entregada
                        </button>
                    </form>

                    <form asp-action="CambiarEstado" method="post" class="m-0 d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id_Encomienda" />
                        <input type="hidden" name="nuevoEstado" value="No reclamado" />
                        <button type="submit" class="btn btn-danger btn-sm fw-bold"
                                onclick="return confirm('¿Marcar como No Reclamado?')">
                            <i class="fa-solid fa-circle-xmark me-1"></i> No Reclamado
                        </button>
                    </form>
                }

                @if (User.IsInRole("Gerente"))
                {
                    <form asp-action="CambiarEstado" method="post" class="m-0 d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id_Encomienda" />
                        <input type="hidden" name="nuevoEstado" value="Anulado" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                onclick="return confirm('¿Anular esta encomienda? Esta acción no se puede deshacer.')">
                            <i class="fa-solid fa-ban me-1"></i> Anular
                        </button>
                    </form>
                }
            }
        </div>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success border-0 mb-3 no-print">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 mb-3 no-print">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
    </div>
}

<!-- LÍNEA DE TIEMPO DEL ESTADO -->
@{
    var estados = new[] { "Registrado", "En transito", "Entregado" };
    int estadoIdx = Array.IndexOf(estados, Model.Estado);
}
<div class="card bg-dark border-glass mb-3 no-print">
    <div class="card-body py-3">
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
            @for (int i = 0; i < estados.Length; i++)
            {
                var activo = i <= estadoIdx && Model.Estado != "Anulado" && Model.Estado != "No reclamado";
                var esActual = estados[i] == Model.Estado;
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex flex-column align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:36px;height:36px;background:@(activo ? "#F37021" : "rgba(255,255,255,0.1)");font-size:14px">
                            @if (estados[i] == "Registrado")
                            { <i class="fa-solid fa-box-open text-white"></i> }
                            else if (estados[i] == "En transito")
                            { <i class="fa-solid fa-truck-fast text-white"></i> }
                            else
                            { <i class="fa-solid fa-circle-check text-white"></i> }
                        </div>
                        <small class="@(activo ? "text-warning fw-bold" : "text-muted") mt-1" style="font-size:11px">@estados[i]</small>
                    </div>
                    @if (i < estados.Length - 1)
                    {
                        <div style="height:2px;width:60px;background:@(i < estadoIdx && Model.Estado != "Anulado" ? "#F37021" : "rgba(255,255,255,0.1)")"></div>
                    }
                </div>
            }
            @if (Model.Estado == "No reclamado")
            {
                <div class="ms-3"><span class="badge bg-danger fs-7 px-3 py-2"><i class="fa-solid fa-circle-xmark me-1"></i>No Reclamado</span></div>
            }
            @if (Model.Estado == "Anulado")
            {
                <div class="ms-3"><span class="badge bg-secondary fs-7 px-3 py-2"><i class="fa-solid fa-ban me-1"></i>Anulado</span></div>
            }
        </div>
    </div>
</div>

<!-- COMPROBANTE (imprimible) -->
<div class="card bg-dark border-glass" id="comprobante">
    <!-- Encabezado -->
    <div class="card-body pb-0">
        <div class="row align-items-center mb-3">
            <div class="col-auto">
                <img src="~/img/logo_oficial.png" alt="Logo" style="height:60px;" />
            </div>
            <div class="col">
                <h5 class="text-white fw-bold mb-0">Tours Chota Express S.A.C.</h5>
                <p class="text-muted mb-0 small">Servicio de Encomiendas</p>
            </div>
            <div class="col-auto text-end">
                <div class="badge @badgeColor fs-6 px-3 py-2">@Model.Estado</div>
                <div class="mt-1">
                    <span class="text-warning fw-bold fs-5">@Model.CodigoSeguimiento</span>
                </div>
            </div>
        </div>
        <hr class="border-secondary" />
    </div>

    <div class="card-body pt-2">
        <div class="row g-4">

            <!-- Remitente -->
            <div class="col-md-6">
                <div class="p-3 rounded" style="background:rgba(255,165,0,0.08); border:1px solid rgba(255,165,0,0.3)">
                    <h6 class="text-warning mb-3"><i class="fa-solid fa-user me-2"></i>Remitente</h6>
                    <p class="mb-1 text-white fw-semibold">@Model.NombreRemitente</p>
                    @if (!string.IsNullOrEmpty(Model.DniRemitente))
                    { <p class="mb-1 text-muted small">DNI/RUC: @Model.DniRemitente</p> }
                    @if (!string.IsNullOrEmpty(Model.TelefonoRemitente))
                    { <p class="mb-0 text-muted small"><i class="fa-solid fa-phone me-1"></i>@Model.TelefonoRemitente</p> }
                </div>
            </div>

            <!-- Destinatario -->
            <div class="col-md-6">
                <div class="p-3 rounded" style="background:rgba(13,202,240,0.08); border:1px solid rgba(13,202,240,0.3)">
                    <h6 class="text-info mb-3"><i class="fa-solid fa-user-check me-2"></i>Destinatario</h6>
                    <p class="mb-1 text-white fw-semibold">@Model.NombreDestinatario</p>
                    @if (!string.IsNullOrEmpty(Model.DniDestinatario))
                    { <p class="mb-1 text-muted small">DNI/RUC: @Model.DniDestinatario</p> }
                    @if (!string.IsNullOrEmpty(Model.TelefonoDestinatario))
                    { <p class="mb-0 text-muted small"><i class="fa-solid fa-phone me-1"></i>@Model.TelefonoDestinatario</p> }
                </div>
            </div>

            <!-- Detalle del paquete -->
            <div class="col-12">
                <div class="card bg-secondary border-0">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <small class="text-muted text-uppercase">Descripcion</small>
                                <p class="text-white mb-0 fw-semibold">@Model.Descripcion</p>
                            </div>
                            <div class="col-md-2 text-center">
                                <small class="text-muted text-uppercase">Peso</small>
                                <p class="text-white mb-0 fw-semibold">
                                    @(Model.PesoKg.HasValue ? $"{Model.PesoKg:N1} kg" : "-")
                                </p>
                            </div>
                            <div class="col-md-2 text-center">
                                <small class="text-muted text-uppercase">Ruta</small>
                                <p class="text-info mb-0 small fw-semibold">
                                    @(Model.ObjetoRuta != null ? $"{Model.ObjetoRuta.Origen} - {Model.ObjetoRuta.Destino}" : "-")
                                </p>
                            </div>
                            <div class="col-md-3 text-end">
                                <small class="text-muted text-uppercase">Precio de envio</small>
                                <p class="text-success fw-bold fs-4 mb-0">S/ @Model.PrecioEnvio.ToString("N2")</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Observaciones))
                        {
                            <hr class="border-dark" />
                            <small class="text-muted">Observaciones: </small>
                            <span class="text-white small">@Model.Observaciones</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Fechas y registro -->
            <div class="col-12">
                <div class="row text-center">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Fecha de registro</small>
                        <span class="text-white">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Fecha de entrega</small>
                        <span class="text-white">@(Model.FechaEntrega.HasValue ? Model.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm") : "-")</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Registrado por</small>
                        <span class="text-white">@(Model.UsuarioRegistro?.Name ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@@media print {
    .no-print { display: none !important; }
    body { background: white !important; color: black !important; }
    .card { border: 1px solid #ccc !important; background: white !important; }
    .text-white, .text-muted, .text-warning, .text-info, .text-success { color: black !important; }
    .bg-dark, .bg-secondary { background: white !important; }
}
</style>
