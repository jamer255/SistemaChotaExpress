@model ErrorViewModel
@{
    ViewData["Title"] = "Aviso del Sistema";
}

<div class="container py-5 text-center">
    <div class="card bg-dark border-glass mx-auto p-4 p-md-5" style="max-width: 600px; border-radius: 20px;">
        <div class="mb-3">
            <div class="rounded-circle d-inline-flex p-3" style="background: rgba(239, 68, 68, 0.15);">
                <i class="fa-solid fa-triangle-exclamation text-danger fs-1"></i>
            </div>
        </div>
        <h2 class="text-white fw-bold mb-2">Ha ocurrido un imprevisto</h2>
        <p class="text-muted mb-4">
            La operación solicitada no pudo completarse en este momento. Hemos registrado el evento para resolverlo de inmediato.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="bg-secondary bg-opacity-25 rounded p-2 mb-4 text-start">
                <small class="text-muted d-block fs-8">Código de seguimiento:</small>
                <code class="text-warning small">@Model.RequestId</code>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <button onclick="window.history.back()" class="btn btn-outline-light px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver atrás
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-bold px-4">
                <i class="fa-solid fa-house me-1"></i> Ir al Inicio
            </a>
        </div>
    </div>
</div>
