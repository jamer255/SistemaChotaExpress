@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Tours Chota Express</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #F37021;
            --primary-dark: #D45B12;
            --dark: #121214;
            --dark-card: rgba(30, 30, 35, 0.75);
            --border-glass: rgba(255, 255, 255, 0.08);
            --text-light: #E1E1E6;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0f0f11 0%, #1c1a24 100%);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            position: relative;
        }

        .glow-blob {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(243, 112, 33, 0.15) 0%, rgba(243, 112, 33, 0) 70%);
            border-radius: 50%;
            z-index: 0;
        }
        .blob-1 { top: -100px; right: -100px; }
        .blob-2 { bottom: -100px; left: -100px; }

        .login-container {
            width: 100%;
            max-width: 480px;
            padding: 20px;
            z-index: 10;
        }

        .login-card {
            background: var(--dark-card);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--border-glass);
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo-svg {
            width: 200px;
            margin-bottom: 10px;
        }

        .brand-subtitle {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #a8a8b2;
            font-weight: 500;
        }

        .nav-tabs-login .nav-link {
            color: #8d8d99;
            border: none;
            border-bottom: 2px solid transparent;
            background: transparent;
            font-weight: 600;
            padding: 10px 20px;
        }

        .nav-tabs-login .nav-link.active {
            color: var(--primary);
            border-bottom: 2px solid var(--primary);
            background: transparent;
        }

        .form-floating {
            margin-bottom: 18px;
            position: relative;
        }

        .form-floating .form-control {
            background: rgba(20, 20, 25, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 12px;
            padding-left: 45px;
        }

        .form-floating .form-control:focus {
            background: rgba(20, 20, 25, 0.8);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(243, 112, 33, 0.15);
        }

        .form-floating label {
            color: #8d8d99;
            left: 35px;
        }

        .form-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #5d5d66;
            z-index: 4;
            pointer-events: none;
        }

        .btn-login {
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            color: white;
            padding: 14px;
            font-weight: 600;
            border-radius: 12px;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 8px;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 112, 33, 0.4);
            filter: brightness(1.1);
        }

        .text-danger {
            color: #f75a68 !important;
            font-size: 0.85rem;
            margin-bottom: 12px;
        }

        .demo-box {
            margin-top: 25px;
            background: rgba(243, 112, 33, 0.05);
            border: 1px dashed rgba(243, 112, 33, 0.25);
            border-radius: 12px;
            padding: 15px;
            font-size: 0.8rem;
            color: #c4c4cc;
        }

        .demo-title {
            font-weight: 600;
            margin-bottom: 5px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <div class="glow-blob blob-1"></div>
    <div class="glow-blob blob-2"></div>

    <div class="login-container">
        <div class="login-card">
            <div class="logo-container text-center mb-3">
                <img src="~/img/logo_oficial.png" alt="Tours Chota Express" style="max-height: 78px; max-width: 250px; width: auto; object-fit: contain; background: #ffffff; padding: 6px 14px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15);" />
                <div class="brand-subtitle mt-2">Control de Pasajes</div>
            </div>

            <!-- TABS: Gerente / Vendedor -->
            <ul class="nav nav-tabs-login justify-content-center mb-3 border-0 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                <li class="nav-item">
                    <button class="nav-link active" id="tab-gerente" onclick="switchTab('gerente')">
                        <i class="fa-solid fa-shield-halved me-1"></i> Gerente
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tab-vendedor" onclick="switchTab('vendedor')">
                        <i class="fa-solid fa-ticket me-1"></i> Trabajador
                    </button>
                </li>
            </ul>

            <!-- FORMULARIO GERENTE -->
            <div id="form-gerente">
                <form asp-controller="Login" asp-action="LoginGerente" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (TempData["ErrorGerente"] != null)
                    {
                        <div class="text-danger mb-2">@TempData["ErrorGerente"]</div>
                    }

                    <div class="form-floating">
                        <input type="email" class="form-control" id="emailGerente" name="Email" placeholder="Correo" required autocomplete="email">
                        <label for="emailGerente">Correo del Gerente</label>
                        <i class="fa-solid fa-envelope form-icon"></i>
                    </div>

                    <div class="form-floating">
                        <input type="password" class="form-control" id="passGerente" name="Password" placeholder="Contraseña" required autocomplete="current-password">
                        <label for="passGerente">Contraseña</label>
                        <i class="fa-solid fa-lock form-icon"></i>
                    </div>

                    <button type="submit" class="btn btn-login">
                        INGRESAR COMO GERENTE <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                    </button>
                </form>
            </div>

            <!-- FORMULARIO TRABAJADOR -->
            <div id="form-vendedor" style="display:none;">
                <form asp-controller="Login" asp-action="LoginVendedor" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (TempData["ErrorVendedor"] != null)
                    {
                        <div class="text-danger mb-2">@TempData["ErrorVendedor"]</div>
                    }

                    <div class="form-floating">
                        <input type="email" class="form-control" id="emailVendedor" name="Email" placeholder="Correo" required autocomplete="email">
                        <label for="emailVendedor">Correo del Trabajador</label>
                        <i class="fa-solid fa-envelope form-icon"></i>
                    </div>

                    <div class="form-floating">
                        <input type="password" class="form-control" id="passVendedor" name="Password" placeholder="Contraseña" required autocomplete="current-password">
                        <label for="passVendedor">Contraseña</label>
                        <i class="fa-solid fa-lock form-icon"></i>
                    </div>

                    <button type="submit" class="btn btn-login">
                        INGRESAR COMO TRABAJADOR <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                    </button>
                </form>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function switchTab(tab) {
            document.getElementById('form-gerente').style.display = tab === 'gerente' ? 'block' : 'none';
            document.getElementById('form-vendedor').style.display = tab === 'vendedor' ? 'block' : 'none';
            document.getElementById('tab-gerente').classList.toggle('active', tab === 'gerente');
            document.getElementById('tab-vendedor').classList.toggle('active', tab === 'vendedor');
        }
    </script>
</body>
</html>
