@model IEnumerable<SistemaChotaExpress.Models.Ruta>
@{
    ViewData["Title"] = "Gestión de Rutas";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h2 text-white fw-bold"><i class="fa-solid fa-route text-primary me-2"></i> Rutas de Viaje</h1>
        <p class="text-muted">Administra los destinos, puntos de partida y tiempos estimados de viaje para los itinerarios.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- List Routes -->
    <div class="col-md-8">
        <div class="card bg-dark text-white border-glass p-4">
            <h5 class="fw-bold mb-3">Rutas Operacionales</h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr class="text-muted border-secondary">
                            <th>Origen</th>
                            <th></th>
                            <th>Destino</th>
                            <th class="text-center">Duración Aprox.</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var r in Model)
                            {
                                <tr>
                                    <td class="fw-bold fs-6">@r.Origen</td>
                                    <td class="text-muted text-center"><i class="fa-solid fa-arrow-right-long text-warning"></i></td>
                                    <td class="fw-bold fs-6">@r.Destino</td>
                                    <td class="text-center"><span class="badge bg-secondary px-3 py-1.5 fs-7"><i class="fa-solid fa-clock me-1"></i> @r.DuracionHoras hrs</span></td>
                                    <td class="text-end">
                                        <form asp-action="EliminarRuta" method="post" class="m-0" onsubmit="return confirm('¿Está seguro de que desea eliminar esta ruta?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id_Ruta" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;">
                                                <i class="fa-solid fa-trash-can me-1"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay rutas registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create Route Form -->
    <div class="col-md-4">
        <div class="card bg-dark text-white border-glass p-4">
            <h5 class="fw-bold mb-3">Registrar Nueva Ruta</h5>
            <form asp-action="CrearRuta" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Ciudad de Origen</label>
                    <input type="text" name="Origen" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. Chiclayo" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Ciudad de Destino</label>
                    <input type="text" name="Destino" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. Chota" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Duración Estimada (Horas)</label>
                    <input type="number" step="0.1" name="DuracionHoras" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. 6.0" min="0.5" max="48" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2.5 mt-2 btn-orange-solid">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Guardar Ruta
                </button>
            </form>
        </div>
    </div>
</div>
