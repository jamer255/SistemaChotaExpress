@model IEnumerable<SistemaChotaExpress.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Trabajadores";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h2 text-white fw-bold"><i class="fa-solid fa-user-tie text-primary me-2"></i> Cuentas de Trabajadores</h1>
        <p class="text-muted">Crea y administra las cuentas de acceso para los vendedores encargados de vender pasajes.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Lista de cuentas -->
    <div class="col-md-8">
        <div class="card bg-dark text-white border-glass p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0"><i class="fa-solid fa-users text-primary me-2"></i> Cuentas del Sistema</h5>
                <span class="badge bg-secondary">Total: @(Model?.Count() ?? 0)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr class="text-muted border-secondary">
                            <th>Nombre Completo</th>
                            <th>Correo / Usuario</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var u in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@u.Name</td>
                                    <td><code class="text-warning">@u.Email</code></td>
                                    <td>@u.Telefono</td>
                                    <td>
                                        @if (u.Id_Rol == 1)
                                        {
                                            <span class="badge bg-primary" style="background-color: rgba(243, 112, 33, 0.2) !important; color: #ff9248 !important; border: 1px solid rgba(243, 112, 33, 0.4);"><i class="fa-solid fa-crown me-1"></i> Gerente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info" style="background-color: rgba(13, 202, 240, 0.15) !important; color: #0dcaf0 !important; border: 1px solid rgba(13, 202, 240, 0.3);"><i class="fa-solid fa-user me-1"></i> Vendedor</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <!-- Restablecer Contraseña -->
                                            <button type="button" class="btn btn-sm btn-outline-warning"
                                                    onclick="openResetModal(@u.Id_Usuario, '@u.Name')"
                                                    style="border-radius: 8px;" title="Restablecer Clave">
                                                <i class="fa-solid fa-key"></i>
                                            </button>

                                            <!-- Eliminar Cuenta -->
                                            <form asp-action="EliminarTrabajador" method="post" class="m-0" onsubmit="return confirm('¿Está seguro de que desea eliminar la cuenta de @u.Name?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id_Usuario" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        style="border-radius: 8px;" title="Eliminar Cuenta">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay cuentas registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Formulario Crear Cuenta -->
    <div class="col-md-4">
        <div class="card bg-dark text-white border-glass p-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-user-plus text-primary me-2"></i> Crear Nueva Cuenta</h5>
            <form asp-action="CrearTrabajador" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Tipo de Rol / Permisos</label>
                    <select name="Id_Rol" class="form-select bg-dark-input text-white border-glass-field" required>
                        <option value="2" selected>Vendedor (Venta y emisión de pasajes)</option>
                        <option value="1">Gerente (Acceso total al sistema)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Nombre Completo</label>
                    <input type="text" name="Name" class="form-control bg-dark-input text-white border-glass-field"
                           placeholder="Ej. Juan Manuel Pérez" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Correo Electrónico (Login)</label>
                    <input type="email" name="Email" class="form-control bg-dark-input text-white border-glass-field"
                           placeholder="Ej. juan@chotaexpress.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Contraseña Inicial</label>
                    <input type="password" name="Password" class="form-control bg-dark-input text-white border-glass-field"
                           placeholder="Mínimo 6 caracteres" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Confirmar Contraseña</label>
                    <input type="password" name="RepetPassword" class="form-control bg-dark-input text-white border-glass-field"
                           placeholder="Repita la contraseña" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Teléfono Celular (9 dígitos)</label>
                    <input type="tel" name="Telefono" class="form-control bg-dark-input text-white border-glass-field"
                           placeholder="Ej. 987654321" pattern="[0-9]{9}" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2.5 mt-1 btn-orange-solid">
                    <i class="fa-solid fa-user-check me-2"></i> Registrar Cuenta
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Restablecer Contraseña -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-labelledby="resetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-glass shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="resetModalLabel">
                    <i class="fa-solid fa-key text-warning me-2"></i> Restablecer Contraseña
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="id" id="resetUserId" />
                    <p>Vas a cambiar la contraseña para: <strong id="resetUserName" class="text-warning"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label text-muted fs-8 font-weight-600">Nueva Contraseña</label>
                        <input type="password" name="newPassword"
                               class="form-control bg-dark-input text-white border-glass-field"
                               placeholder="Nueva clave" required />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal" style="border-radius: 8px;">Cancelar</button>
                    <button type="submit" class="btn btn-warning" style="border-radius: 8px;">Restablecer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetModal(id, name) {
            document.getElementById('resetUserId').value = id;
            document.getElementById('resetUserName').innerText = name;
            const myModal = new bootstrap.Modal(document.getElementById('resetModal'));
            myModal.show();
        }
    </script>
}
