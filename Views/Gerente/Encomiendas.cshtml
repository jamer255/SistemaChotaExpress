@model IEnumerable<SistemaChotaExpress.Models.Encomienda>
@{
    ViewData["Title"] = "Gestión de Encomiendas";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h2 text-white fw-bold mb-0"><i class="fa-solid fa-boxes-stacked me-2 text-warning"></i>Gestión de Encomiendas</h1>
            <p class="text-muted mb-0">Panel gerencial — todas las encomiendas del sistema</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Encomienda" asp-action="Rastrear" class="btn btn-outline-info btn-sm fw-bold">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Rastrear
            </a>
            <a asp-controller="Encomienda" asp-action="Registrar" class="btn btn-warning fw-bold px-4">
                <i class="fa-solid fa-plus me-1"></i> Nueva Encomienda
            </a>
        </div>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success border-0 mb-3">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
    </div>
}

<!-- KPIs de resumen -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card bg-dark border-glass p-3 text-center position-relative overflow-hidden">
            <div style="position:absolute;top:-20px;right:-10px;width:80px;height:80px;border-radius:50%;background:rgba(243,112,33,0.1)"></div>
            <i class="fa-solid fa-box text-warning mb-1"></i>
            <div class="fw-bold text-white fs-3">@ViewBag.TotalEncomiendas</div>
            <small class="text-muted">Total</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-dark border-glass p-3 text-center position-relative overflow-hidden">
            <div style="position:absolute;top:-20px;right:-10px;width:80px;height:80px;border-radius:50%;background:rgba(25,135,84,0.1)"></div>
            <i class="fa-solid fa-circle-check text-success mb-1"></i>
            <div class="fw-bold text-success fs-3">@ViewBag.TotalEntregadas</div>
            <small class="text-muted">Entregadas</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-dark border-glass p-3 text-center position-relative overflow-hidden">
            <div style="position:absolute;top:-20px;right:-10px;width:80px;height:80px;border-radius:50%;background:rgba(13,202,240,0.1)"></div>
            <i class="fa-solid fa-truck-fast text-info mb-1"></i>
            <div class="fw-bold text-info fs-3">@ViewBag.TotalPendientes</div>
            <small class="text-muted">En proceso</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-dark border-glass p-3 text-center position-relative overflow-hidden">
            <div style="position:absolute;top:-20px;right:-10px;width:80px;height:80px;border-radius:50%;background:rgba(255,193,7,0.1)"></div>
            <i class="fa-solid fa-sack-dollar text-warning mb-1"></i>
            <div class="fw-bold text-warning fs-4">S/ @((ViewBag.TotalCobrado as decimal? ?? 0m).ToString("N2"))</div>
            <small class="text-muted">Total cobrado</small>
        </div>
    </div>
</div>

<!-- Filtros avanzados -->
<div class="card bg-dark border-glass mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small">Buscar por código, remitente, destinatario o DNI</label>
                <div class="input-group">
                    <span class="input-group-text bg-secondary border-0"><i class="fa-solid fa-magnifying-glass text-white"></i></span>
                    <input type="text" name="buscar" class="form-control bg-secondary border-0 text-white"
                           placeholder="Ej: ECE-2026-0001" value="@ViewBag.Buscar" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Estado</label>
                <select name="estado" class="form-select bg-secondary border-0 text-white">
                    <option value="Todos" selected="@(ViewBag.EstadoFiltro == "Todos")">Todos</option>
                    <option value="Registrado" selected="@(ViewBag.EstadoFiltro == "Registrado")">Registrado</option>
                    <option value="En transito" selected="@(ViewBag.EstadoFiltro == "En transito")">En tránsito</option>
                    <option value="Entregado" selected="@(ViewBag.EstadoFiltro == "Entregado")">Entregado</option>
                    <option value="No reclamado" selected="@(ViewBag.EstadoFiltro == "No reclamado")">No reclamado</option>
                    <option value="Anulado" selected="@(ViewBag.EstadoFiltro == "Anulado")">Anulado</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Desde</label>
                <input type="date" name="fechaDesde" class="form-control bg-secondary border-0 text-white" value="@ViewBag.FechaDesde" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Hasta</label>
                <input type="date" name="fechaHasta" class="form-control bg-secondary border-0 text-white" value="@ViewBag.FechaHasta" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-warning w-100">Filtrar</button>
                <a asp-action="Encomiendas" class="btn btn-outline-secondary" title="Limpiar"><i class="fa-solid fa-xmark"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de encomiendas -->
<div class="card bg-dark border-glass">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-box-open fa-3x mb-3 opacity-50"></i>
                <p>No se encontraron encomiendas con los filtros aplicados.</p>
                <a asp-controller="Encomienda" asp-action="Registrar" class="btn btn-warning btn-sm">Registrar encomienda</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr class="text-muted small text-uppercase border-secondary">
                            <th>Código</th>
                            <th>Remitente</th>
                            <th>Destinatario</th>
                            <th>Ruta</th>
                            <th>Precio</th>
                            <th>Estado</th>
                            <th>Registrado por</th>
                            <th>Fecha</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enc in Model)
                        {
                            var badgeColor = enc.Estado switch {
                                "Registrado"   => "bg-secondary",
                                "En transito"  => "bg-info text-dark",
                                "Entregado"    => "bg-success",
                                "No reclamado" => "bg-danger",
                                "Anulado"      => "bg-dark border border-secondary",
                                _ => "bg-secondary"
                            };
                            <tr class="@(enc.Estado == "Anulado" ? "opacity-50" : "")">
                                <td><span class="badge bg-warning text-dark fw-bold">@enc.CodigoSeguimiento</span></td>
                                <td>
                                    <div class="fw-semibold">@enc.NombreRemitente</div>
                                    @if (!string.IsNullOrEmpty(enc.DniRemitente))
                                    { <small class="text-muted">@enc.DniRemitente</small> }
                                </td>
                                <td>
                                    <div class="fw-semibold">@enc.NombreDestinatario</div>
                                    @if (!string.IsNullOrEmpty(enc.TelefonoDestinatario))
                                    { <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@enc.TelefonoDestinatario</small> }
                                </td>
                                <td>
                                    @if (enc.ObjetoRuta != null)
                                    { <small><i class="fa-solid fa-route me-1 text-info"></i>@enc.ObjetoRuta.Origen → @enc.ObjetoRuta.Destino</small> }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <td class="fw-bold text-success">S/ @enc.PrecioEnvio.ToString("N2")</td>
                                <td><span class="badge @badgeColor">@enc.Estado</span></td>
                                <td><small class="text-muted">@(enc.UsuarioRegistro?.Name ?? "-")</small></td>
                                <td><small class="text-muted">@enc.FechaRegistro.ToString("dd/MM/yy HH:mm")</small></td>
                                <td class="text-end">
                                    <a asp-controller="Encomienda" asp-action="Detalle" asp-route-id="@enc.Id_Encomienda"
                                       class="btn btn-outline-light btn-sm px-2" title="Ver detalle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
                <small class="text-muted">@Model.Count() encomienda(s) | Entregadas: @Model.Count(e => e.Estado == "Entregado") | Pendientes: @Model.Count(e => e.Estado is "Registrado" or "En transito")</small>
                <strong class="text-warning">Total: S/ @Model.Where(e => e.Estado != "Anulado").Sum(e => e.PrecioEnvio).ToString("N2")</strong>
            </div>
        }
    </div>
</div>
