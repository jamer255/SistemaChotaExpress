@model IEnumerable<SistemaChotaExpress.Models.Bus>
@{
    ViewData["Title"] = "Gestión de Buses";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h2 text-white fw-bold"><i class="fa-solid fa-truck-front text-primary me-2"></i> Flota de Buses y Combis</h1>
        <p class="text-muted">Administra los vehículos que prestan servicios de transporte de pasajeros para la empresa.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- List Buses -->
    <div class="col-md-8">
        <div class="card bg-dark text-white border-glass p-4">
            <h5 class="fw-bold mb-3">Flota Registrada</h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr class="text-muted border-secondary">
                            <th>Nombre del Vehículo</th>
                            <th>Nombre del Conductor</th>
                            <th>Modelo / Placa</th>
                            <th class="text-center">Capacidad</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var b in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary text-white font-monospace px-2.5 py-1.5 fs-7"><i class="fa-solid fa-van-shuttle me-1"></i>@b.NombreVehiculo</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-light"><i class="fa-solid fa-id-card text-warning me-1"></i>@(b.NombreConductor ?? "Sin Conductor")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@b.Modelo</div>
                                        <small class="text-muted font-monospace">Placa: @(string.IsNullOrWhiteSpace(b.Placa) ? "S/P" : b.Placa)</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge px-3 py-1.5 fs-7" style="background-color: rgba(243, 112, 33, 0.2) !important; color: #ff9248 !important; border: 1px solid rgba(243, 112, 33, 0.4);">@b.Capacidad Asientos</span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="EliminarBus" method="post" class="m-0" onsubmit="return confirm('¿Está seguro de que desea eliminar este vehículo?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id_Bus" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;">
                                                <i class="fa-solid fa-trash-can me-1"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay vehículos registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create Bus Form -->
    <div class="col-md-4">
        <div class="card bg-dark text-white border-glass p-4">
            <h5 class="fw-bold mb-3">Registrar Nuevo Vehículo</h5>
            <form asp-action="CrearBus" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Nombre del Vehículo</label>
                    <input type="text" name="NombreVehiculo" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. Combi 01 - Chotano" required />
                    <small class="text-muted fs-9">Identificador visible (Ej. Combi 01, Toyota 2)</small>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Nombre del Conductor (Chofer)</label>
                    <input type="text" name="NombreConductor" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. Juan Pérez" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Modelo / Marca</label>
                    <input type="text" name="Modelo" class="form-control bg-dark-input text-white border-glass-field" placeholder="Ej. Toyota HiAce" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Placa (Opcional)</label>
                    <input type="text" name="Placa" class="form-control bg-dark-input text-white border-glass-field font-monospace text-uppercase" placeholder="Ej. MSH-206" maxlength="10" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8 font-weight-600">Capacidad de Asientos</label>
                    <select name="Capacidad" class="form-select bg-dark-input text-white border-glass-field" required>
                        <option value="15" selected>15 Asientos (Distribución Combi Estándar)</option>
                        <option value="20">20 Asientos</option>
                        <option value="30">30 Asientos</option>
                        <option value="40">40 Asientos</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2.5 mt-2 btn-orange-solid">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Guardar Vehículo
                </button>
            </form>
        </div>
    </div>
</div>
