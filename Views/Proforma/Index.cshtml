@model IEnumerable<SistemaChotaExpress.Models.ProformaViaje>
@{
    ViewData["Title"] = "Proformas de Viajes";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h2 text-white fw-bold mb-0">
            <i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i>Proformas de Viajes
        </h1>
        <p class="text-muted mb-0">Cotizaciones y presupuestos de pasajes y viajes expresos emitidos</p>
    </div>
    <div>
        <a asp-action="Crear" class="btn btn-warning fw-bold px-3 py-2 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nueva Proforma
        </a>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success border-0 mb-3">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 mb-3">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
    </div>
}

<!-- FILTROS -->
<div class="card bg-dark border-glass mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-secondary border-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control bg-secondary border-0 text-white"
                           placeholder="Buscar por código, cliente, DNI o teléfono..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="estado" class="form-select bg-secondary border-0 text-white">
                    <option value="Todos" selected="@(ViewBag.EstadoFiltro == "Todos")">-- Todos los estados --</option>
                    <option value="Emitida" selected="@(ViewBag.EstadoFiltro == "Emitida")">Emitida</option>
                    <option value="Aprobada" selected="@(ViewBag.EstadoFiltro == "Aprobada")">Aprobada</option>
                    <option value="Vencida" selected="@(ViewBag.EstadoFiltro == "Vencida")">Vencida</option>
                    <option value="Anulada" selected="@(ViewBag.EstadoFiltro == "Anulada")">Anulada</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold flex-grow-1">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE PROFORMAS -->
<div class="card bg-dark border-glass shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="border-secondary text-muted small text-uppercase">
                        <th class="ps-3">Código</th>
                        <th>Fecha Emisión</th>
                        <th>Cliente</th>
                        <th>Ruta</th>
                        <th>Fecha Viaje</th>
                        <th>Servicio</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-circle-question fs-1 mb-3 d-block opacity-50"></i>
                                No se encontraron proformas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var badgeClass = item.Estado switch
                            {
                                "Aprobada" => "bg-success",
                                "Emitida"  => "bg-warning text-dark",
                                "Vencida"  => "bg-secondary",
                                "Anulada"  => "bg-danger",
                                _ => "bg-info"
                            };

                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-warning">
                                    @item.CodigoProforma
                                </td>
                                <td class="small text-muted">
                                    @item.FechaEmision.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@item.NombreCliente</div>
                                    @if (!string.IsNullOrWhiteSpace(item.NumeroDocumento))
                                    {
                                        <small class="text-muted fs-9">@(item.TipoDocumento ?? "DOC"): @item.NumeroDocumento</small>
                                    }
                                </td>
                                <td>
                                    <span class="text-info small fw-bold">
                                        @(item.ObjetoRuta != null ? $"{item.ObjetoRuta.Origen} ➔ {item.ObjetoRuta.Destino}" : "-")
                                    </span>
                                </td>
                                <td class="small">
                                    @item.FechaViaje.ToString("dd/MM/yyyy")
                                    @if (!string.IsNullOrWhiteSpace(item.HoraSalida))
                                    {
                                        <span class="d-block text-muted fs-9">@item.HoraSalida</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary fs-9">@item.TipoServicio</span>
                                    <small class="d-block text-muted fs-9">@item.CantidadPasajeros pasajeros</small>
                                </td>
                                <td class="text-end fw-bold text-success fs-6">
                                    S/ @item.PrecioTotal.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass fs-9 px-2 py-1">@item.Estado</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Imprimir" asp-route-id="@item.Id_Proforma" target="_blank"
                                           class="btn btn-outline-warning btn-sm" title="Imprimir Hoja A4">
                                            <i class="fa-solid fa-print"></i>
                                        </a>

                                        @if (item.Estado == "Emitida")
                                        {
                                            <form asp-action="CambiarEstado" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id_Proforma" />
                                                <input type="hidden" name="nuevoEstado" value="Aprobada" />
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Marcar como Aprobada">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
