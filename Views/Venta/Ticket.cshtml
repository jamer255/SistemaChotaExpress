@model List<SistemaChotaExpress.Models.Venta>
@using SistemaChotaExpress.Services
@{
    Layout = null;
    int count = Model.Count;
    var primerVenta = Model.FirstOrDefault();
    string rucEmisor = "20600308883";
    string empresaEmisor = "EMPRESA DE MULTISERVICIOS Y TRANSPORTES TURS CHOTA EXPRESS S.A.C.";
    string nombreComercial = "TOURS CHOTA EXPRESS";
    string direccionEmisor = "CAL. SARA MACDOUGALL NRO. 218 BAR. SAN JOSE - CHOTA - CAJAMARCA";

    var agencias = new[] {
        new { Ciudad = "CHOTA (Principal)", Dir = "Jr. José Arana 290 / Cal. Sara Macdougall 218", Tel = "948 211 532" },
        new { Ciudad = "CHICLAYO", Dir = "Calle Agricultura 210", Tel = "941 931 014" },
        new { Ciudad = "CUTERVO", Dir = "Jr. 22 de Octubre 1713 / Jr. Comercio 1116", Tel = "954 956 993" },
        new { Ciudad = "CAJAMARCA", Dir = "Jr. Angamos 970", Tel = "951 314 266 / (076) 267458" },
        new { Ciudad = "BAMBAMARCA", Dir = "Av. Ricardo Palma 697", Tel = "948 211 532" }
    };

    bool esTodoReserva = Model.All(v => v.Estado == "Reservado");
    string tituloGeneral = esTodoReserva ? "TICKET DE RESERVA" : (count > 1 ? $"TICKETS DE PASAJE ({count})" : "TICKET DE PASAJE");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tituloGeneral - Tours Chota Express</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Consolas', 'Courier New', monospace, sans-serif;
            background-color: #1a1d21;
            color: #111;
            margin: 0;
            padding: 15px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Toolbar / Panel de Acciones Superior */
        .actions-panel {
            width: 100%;
            max-width: 820px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #23272d;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 18px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.45);
            gap: 12px;
            flex-wrap: wrap;
        }

        .actions-title {
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .view-switch-btns {
            display: flex;
            background: #14171a;
            padding: 3px;
            border-radius: 8px;
            gap: 4px;
        }

        .btn-tab {
            background: transparent;
            color: #94a3b8;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-tab:hover {
            color: #fff;
            background: rgba(255,255,255,0.08);
        }

        .btn-tab.active {
            background: #10b981;
            color: #fff;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border-radius: 7px;
            font-size: 0.86rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-print  { background-color: #10b981; color: #fff; }
        .btn-print:hover  { background-color: #059669; color: #fff; transform: translateY(-1px); }
        .btn-back   { background-color: #3b82f6; color: #fff; }
        .btn-back:hover   { background-color: #2563eb; color: #fff; }
        .btn-ventas { background-color: #475569; color: #fff; }
        .btn-ventas:hover { background-color: #334155; color: #fff; }

        /* Contenedor de Tickets Térmicos */
        .tickets-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
            width: 100%;
        }

        /* =============================================
           FORMATO TÉRMICO POS 80mm / 72mm (ANCHO SEGURO)
           ============================================= */
        .ticket-termal {
            display: block;
            width: 100%;
            max-width: 300px;
            background: #ffffff;
            font-family: 'Consolas', 'Courier New', monospace, sans-serif;
            color: #000;
            padding: 12px 10px;
            border-radius: 6px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            font-size: 10.5px;
            line-height: 1.3;
            box-sizing: border-box;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        .t-top-sub { font-size: 8.5px; text-align: center; color: #444; margin-bottom: 2px; font-weight: bold; }
        .t-empresa { font-size: 15px; font-weight: 900; color: #f97316; text-transform: uppercase; text-align: center; letter-spacing: 0.5px; line-height: 1.15; }
        .t-sac { font-size: 9px; font-weight: 700; text-align: center; color: #111; margin-top: 1px; line-height: 1.2; }
        .t-info-emisor { font-size: 9px; color: #111; text-align: center; margin: 1.5px 0; line-height: 1.25; }
        
        /* Bloque estructurado de agencias y contactos */
        .t-oficinas-bloque {
            border-top: 1px dashed #777;
            border-bottom: 1px dashed #777;
            padding: 4px 2px;
            margin: 5px 0;
            font-size: 8.5px;
            line-height: 1.25;
            text-align: left;
        }
        .t-oficinas-title {
            font-weight: 900;
            text-align: center;
            font-size: 8.5px;
            margin-bottom: 3px;
            color: #000;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .t-oficina-fila {
            margin-bottom: 2.5px;
            display: flex;
            flex-direction: column;
            word-break: break-word;
        }
        .t-ofi-nombre {
            font-weight: 800;
            color: #000;
        }
        .t-ofi-datos {
            color: #222;
            padding-left: 5px;
            font-size: 8px;
        }

        .t-dotted { border: none; border-top: 1px dashed #777; margin: 6px 0; }
        
        .t-title { font-size: 12px; font-weight: 900; text-align: center; text-transform: uppercase; margin: 3px 0 1px 0; color: #000; }
        .t-title.t-reserva { color: #d97706; }
        .t-serie { font-size: 11.5px; font-weight: 800; text-align: center; margin-bottom: 5px; color: #000; letter-spacing: 0.5px; }

        .t-badge-reserva {
            background-color: #fef3c7;
            border: 1.5px dashed #f59e0b;
            color: #b45309;
            font-weight: 900;
            text-align: center;
            padding: 4px;
            border-radius: 4px;
            font-size: 9.5px;
            margin: 4px 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .t-badge-vendido {
            background-color: #d1fae5;
            border: 1.5px solid #10b981;
            color: #065f46;
            font-weight: 900;
            text-align: center;
            padding: 3px;
            border-radius: 4px;
            font-size: 9.5px;
            margin: 4px 0;
            text-transform: uppercase;
        }
        
        .t-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 4px;
            margin: 2px 0;
            font-size: 10px;
            word-break: break-word;
            overflow-wrap: break-word;
        }
        .t-row .t-key { color: #000; font-weight: 700; flex-shrink: 0; }
        .t-row .t-val { font-weight: 700; text-align: right; color: #000; word-break: break-word; overflow-wrap: break-word; }
        
        .t-section-header { font-size: 10px; font-weight: 900; text-transform: uppercase; color: #000; margin: 6px 0 3px 0; letter-spacing: 0.5px; border-bottom: 1px dotted #ccc; padding-bottom: 2px; }
        .t-pasajero-nombre { font-weight: 900; text-transform: uppercase; margin: 2px 0 4px 0; font-size: 11px; color: #000; }
        
        .t-ruta-box { margin: 4px 0; }
        .t-ruta-title { font-size: 12px; font-weight: 900; text-align: right; text-transform: uppercase; color: #000; }
        .t-salida-fecha { font-size: 12px; font-weight: 800; text-align: right; color: #dc2626; }
        .t-salida-hora { font-size: 13px; font-weight: 900; text-align: right; color: #dc2626; }
        
        .t-asiento-box {
            text-align: center;
            margin: 10px 0 8px 0;
            background: #f8fafc;
            border: 2px solid #000;
            border-radius: 8px;
            padding: 6px;
        }
        .t-asiento-label { font-size: 10px; font-weight: 800; text-transform: uppercase; color: #000; letter-spacing: 1px; }
        .t-asiento-val { font-size: 26px; font-weight: 900; color: #000; text-transform: uppercase; letter-spacing: 1px; margin-top: 1px; line-height: 1; }
        
        .t-totales-box {
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            border-radius: 6px;
            padding: 8px 10px;
            margin: 8px 0;
        }
        .t-total-sub { display: flex; justify-content: space-between; font-size: 10.5px; margin: 2px 0; font-weight: 600; color: #222; }
        .t-total-sub strong { font-weight: 800; }
        .t-totales-box hr { border: none; border-top: 1px dashed #94a3b8; margin: 5px 0; }
        .t-total-final { display: flex; justify-content: space-between; align-items: center; margin-top: 3px; }
        .t-total-final-lbl { font-size: 11px; font-weight: 900; color: #000; text-transform: uppercase; }
        .t-total-final-val { font-size: 16px; font-weight: 900; color: #059669; }
        .t-total-final-val.reserva-val { color: #d97706; }

        .t-barcode-box { text-align: center; margin: 8px 0 4px 0; }
        .t-barcode-box svg { max-width: 100%; height: 42px; }
        .t-barcode-text { font-size: 9px; color: #444; letter-spacing: 1px; margin-top: 2px; }
        
        .t-footer-msg { font-size: 8.5px; text-align: center; color: #444; line-height: 1.35; margin-top: 8px; border-top: 1px dotted #888; padding-top: 6px; }

        /* =============================================
           FORMATO FORMAL A4 (Oculto por defecto)
           ============================================= */
        .doc-a4-container {
            display: none; /* Oculto por defecto */
            flex-direction: column;
            gap: 30px;
            width: 100%;
            max-width: 800px;
        }

        .doc-a4 {
            width: 100%;
            min-height: 1000px;
            background: #ffffff;
            padding: 35px 42px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.45);
            box-sizing: border-box;
            font-family: 'Roboto', sans-serif;
        }

        .a4-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; gap: 18px; }
        .box-emisor { flex: 1.15; border: 1.5px solid #555; border-radius: 12px; padding: 14px 16px; min-height: 120px; display: flex; flex-direction: column; justify-content: center; }
        .emisor-title { font-size: 0.90rem; font-weight: 900; line-height: 1.35; color: #000; text-transform: uppercase; margin-bottom: 6px; }
        .emisor-comercial { font-size: 0.90rem; font-weight: 800; color: #f97316; margin-bottom: 4px; }
        .emisor-dir { font-size: 0.80rem; color: #222; line-height: 1.35; }
        .emisor-extra { font-size: 0.74rem; color: #444; margin-top: 4px; }
        .box-sunat { flex: 0.85; border: 2px solid #222; border-radius: 12px; padding: 12px 10px; text-align: center; min-height: 120px; display: flex; flex-direction: column; justify-content: space-around; align-items: center; }
        .sunat-ruc { font-size: 1.10rem; font-weight: 800; color: #000; }
        .sunat-doc-type { font-size: 1rem; font-weight: 900; color: #fff; background-color: #212529; padding: 5px 10px; border-radius: 6px; text-transform: uppercase; width: 92%; margin: 3px 0; }
        .sunat-number { font-size: 1.12rem; font-weight: 800; color: #000; letter-spacing: 1px; font-family: monospace; }

        .box-customer { border: 1.5px solid #555; border-radius: 12px; padding: 12px 18px; margin-bottom: 12px; }
        .customer-grid { display: grid; grid-template-columns: 1.2fr 1fr; row-gap: 6px; column-gap: 20px; font-size: 0.83rem; color: #111; }
        .customer-item strong { font-weight: 800; color: #000; margin-right: 4px; }

        .box-transporte { border: 1.5px solid #555; border-radius: 12px; padding: 10px 16px; margin-bottom: 14px; background-color: #f8f9fa; }
        .transporte-title { font-size: 0.76rem; font-weight: 800; color: #0d6efd; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; border-bottom: 1px dashed #ccc; padding-bottom: 3px; }
        .transporte-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px 14px; font-size: 0.80rem; color: #222; }
        .badge-asiento { background-color: #f97316; color: #fff; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 0.82rem; display: inline-block; }

        .box-items { border: 1.5px solid #555; border-radius: 12px; overflow: hidden; margin-bottom: 18px; }
        .items-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
        .items-table thead tr { border-bottom: 1.5px solid #555; }
        .items-table th { padding: 8px 10px; font-weight: 800; color: #000; }
        .items-table td { padding: 10px 10px; color: #111; font-size: 0.83rem; }

        .middle-section { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 25px; }
        .left-notes { flex: 1.15; }
        .monto-letras { font-size: 0.84rem; font-weight: 800; color: #000; margin-bottom: 12px; }
        .adicional-title { font-size: 0.84rem; font-weight: 800; color: #000; margin-bottom: 4px; }
        .adicional-divider { border: 0; border-top: 1px solid #777; margin: 4px 0 10px 0; width: 100%; }
        .adicional-details { font-size: 0.76rem; color: #111; line-height: 1.45; }
        .adicional-label { font-weight: 800; font-size: 0.76rem; margin-bottom: 4px; }
        .adicional-obs-grid { display: grid; grid-template-columns: 105px 1fr; row-gap: 2px; margin-top: 2px; }
        .right-totals { flex: 0.85; display: flex; flex-direction: column; gap: 8px; }
        .total-row { display: flex; justify-content: flex-end; align-items: baseline; gap: 14px; }
        .total-label { font-weight: 800; font-size: 0.85rem; color: #000; min-width: 110px; text-align: right; }
        .total-line-val { border-bottom: 1px solid #444; min-width: 120px; text-align: right; padding-bottom: 2px; font-size: 0.85rem; font-weight: 600; color: #000; }
        .total-final .total-line-val { font-weight: 800; }

        .page-divider { border: 0; border-top: 1.5px solid #333; margin: 0 0 16px 0; width: 100%; }
        .footer-section { display: flex; justify-content: space-between; align-items: center; gap: 18px; }
        .box-hash { flex: 1; border: 1px solid #b5b5b5; padding: 10px 14px; font-size: 0.78rem; color: #111; line-height: 1.4; }
        .box-hash strong { font-weight: 800; }
        .box-qr { width: 110px; height: 110px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
        .box-qr img { width: 100px; height: 100px; display: block; }

        /* =============================================
           ESTILOS DE IMPRESIÓN (PRINT CSS)
           ============================================= */
        @@media print {
            body {
                background: #fff !important;
                padding: 0 !important;
                margin: 0 !important;
                color: #000 !important;
            }
            .no-print { display: none !important; }

            /* Por defecto o en modo térmico: Imprime tickets térmicos POS 80mm / 72mm */
            body:not(.printing-a4) .tickets-container {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            body:not(.printing-a4) .ticket-termal {
                display: block !important;
                box-shadow: none !important;
                border: none !important;
                width: 70mm !important;
                max-width: 70mm !important;
                margin: 0 auto 5mm auto !important;
                padding: 1.5mm 2.5mm !important;
                box-sizing: border-box !important;
                overflow: hidden !important;
                page-break-after: always;
                break-after: page;
            }
            body:not(.printing-a4) .doc-a4-container { display: none !important; }
            @@page { size: 80mm auto; margin: 0; }

            /* Modo A4 Formal (Solo si el usuario seleccionó la pestaña A4) */
            body.printing-a4 .doc-a4-container {
                display: block !important;
                width: 100% !important;
            }
            body.printing-a4 .doc-a4 {
                display: block !important;
                box-shadow: none !important;
                border: none !important;
                padding: 10mm 15mm !important;
                width: 100% !important;
                max-width: 100% !important;
                min-height: auto !important;
                page-break-after: always;
                break-after: page;
            }
            body.printing-a4 .tickets-container { display: none !important; }
        }
    </style>
</head>
<body id="pageBody">

    <!-- BARRA DE ACCIONES (NO SE IMPRIME) -->
    <div class="actions-panel no-print">
        <div class="actions-title">
            <i class="fa-solid fa-receipt text-warning"></i>
            <span>@tituloGeneral</span>
            @if (count > 1)
            {
                <span style="background: #10b981; color: #fff; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem;">@count Boletos</span>
            }
        </div>

        <!-- Selector de formato de vista -->
        <div class="view-switch-btns">
            <button type="button" onclick="mostrarVista('termal')" id="tabBtnTermal" class="btn-tab active" title="Formato Ticket para impresora térmica POS de 80mm">
                <i class="fa-solid fa-receipt"></i> Ticket Térmico (80mm)
            </button>
            <button type="button" onclick="mostrarVista('a4')" id="tabBtnA4" class="btn-tab" title="Formato Hoja A4 Factura / Boleta Formal">
                <i class="fa-solid fa-file-lines"></i> Vista A4 Formal
            </button>
        </div>

        <!-- Botones de Impresión y Retorno -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <button onclick="imprimirTermal()" class="btn-action btn-print" title="Imprimir Ticket para el pasajero">
                <i class="fa-solid fa-print"></i> Imprimir Ticket
            </button>

            <a href="@Url.Action("BuscarViajes", "Venta")" class="btn-action btn-back" title="Regresar al panel de ventas de pasajes">
                <i class="fa-solid fa-arrow-left"></i> Volver a Salidas
            </a>

            <a href="@Url.Action("MisVentas", "Venta")" class="btn-action btn-ventas" title="Ver registro completo de ventas">
                <i class="fa-solid fa-list-check"></i> Registro Ventas
            </a>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 1. FORMATO TÉRMICO POS 80MM (ACTIVO Y VISIBLE POR DEFECTO) -->
    <!-- ======================================================== -->
    <div class="tickets-container" id="ticketsTermalContainer">
        @foreach (var v in Model)
        {
            bool esReserva = (v.Estado == "Reservado");
            bool esFactura = (v.TipoComprobante == "Factura");
            string tipoTituloTicket = esReserva ? "TICKET DE RESERVA" : (esFactura ? "FACTURA ELECTRÓNICA" : (v.TipoComprobante == "Ticket" ? "TICKET DE VIAJE" : "BOLETA DE VENTA ELECTRÓNICA"));
            string seriePrefijo = esReserva ? "RES" : (esFactura ? "F001" : (v.TipoComprobante == "Ticket" ? "T001" : "B001"));
            string serieCorrelativoTicket = $"{seriePrefijo}-{v.Id_Venta:D8}";

            decimal subtotalV = Math.Round(v.PrecioPagado / 1.18m, 2);
            decimal igvV = v.PrecioPagado - subtotalV;

            <div class="ticket-termal">
                <div class="t-top-sub">@serieCorrelativoTicket - Tours Chota Express</div>

                <div class="t-empresa">@nombreComercial</div>
                <div class="t-sac">@empresaEmisor</div>
                <div class="t-info-emisor"><strong>RUC:</strong> @rucEmisor</div>
                <div class="t-info-emisor"><strong>DIR. FISCAL:</strong> @direccionEmisor</div>

                <!-- Bloque organizado de agencias y sus teléfonos de contacto -->
                <div class="t-oficinas-bloque">
                    <div class="t-oficinas-title">OFICINAS Y TELÉFONOS</div>
                    @foreach (var ag in agencias)
                    {
                        <div class="t-oficina-fila">
                            <span class="t-ofi-nombre">📍 @ag.Ciudad:</span>
                            <span class="t-ofi-datos">@ag.Dir - <strong>Cel: @ag.Tel</strong></span>
                        </div>
                    }
                </div>

                <hr class="t-dotted" />

                <div class="t-title @(esReserva ? "t-reserva" : "")">@tipoTituloTicket</div>
                <div class="t-serie">@serieCorrelativoTicket</div>

                @if (esReserva)
                {
                    <div class="t-badge-reserva">
                        <i class="fa-solid fa-hourglass-half me-1"></i> RESERVADO - PENDIENTE DE PAGO
                    </div>
                }
                else
                {
                    <div class="t-badge-vendido">
                        <i class="fa-solid fa-circle-check me-1"></i> COMPROBANTE EMITIDO - PAGADO
                    </div>
                }

                <div class="t-row"><span class="t-key">Fecha Emisión:</span><span class="t-val">@v.FechaVenta.ToString("dd/MM/yyyy HH:mm")</span></div>
                <div class="t-row"><span class="t-key">Forma de Pago:</span><span class="t-val">@(esReserva ? "Pendiente" : (v.MetodoPago ?? "Efectivo"))</span></div>
                <div class="t-row"><span class="t-key">Atendido por:</span><span class="t-val">@(v.ObjetoUsuario?.Name ?? "Agencia Chota")</span></div>

                <hr class="t-dotted" />

                <div class="t-section-header">DATOS DEL PASAJERO</div>
                <div class="t-row"><span class="t-key">Documento:</span><span class="t-val">@(v.ObjetoPasajero?.TipoDocumento ?? "DNI"): @(v.ObjetoPasajero?.NumeroDocumento ?? "-")</span></div>
                <div class="t-row" style="margin-bottom: 0;"><span class="t-key">Pasajero:</span></div>
                <div class="t-pasajero-nombre">@(v.ObjetoPasajero?.NombreCompleto?.ToUpper() ?? "PASAJERO GENERAL")</div>

                @if (esFactura && !string.IsNullOrWhiteSpace(v.RucEmpresa))
                {
                    <div class="t-row"><span class="t-key">RUC Empresa:</span><span class="t-val">@v.RucEmpresa</span></div>
                    <div class="t-row"><span class="t-key">Razón Social:</span><span class="t-val">@v.RazonSocialEmpresa</span></div>
                }

                <hr class="t-dotted" />

                <div class="t-section-header">DETALLES DEL VIAJE</div>
                <div class="t-row">
                    <span class="t-key">Ruta:</span>
                    <span class="t-ruta-title">@(v.ObjetoViaje?.ObjetoRuta?.Origen?.ToUpper() ?? "CHOTA") ➔ @(v.ObjetoViaje?.ObjetoRuta?.Destino?.ToUpper() ?? "CHICLAYO")</span>
                </div>
                <div class="t-row">
                    <span class="t-key">Fecha Salida:</span>
                    <span class="t-salida-fecha">@(v.ObjetoViaje?.FechaHoraSalida.ToString("dd/MM/yyyy") ?? "-")</span>
                </div>
                <div class="t-row">
                    <span class="t-key">Hora Salida:</span>
                    <span class="t-salida-hora">@(v.ObjetoViaje?.FechaHoraSalida.ToString("hh:mm tt") ?? "-")</span>
                </div>
                <div class="t-row" style="align-items: baseline;">
                    <span class="t-key" style="min-width: 80px;">Vehículo/Chofer:</span>
                    <span class="t-val" style="font-size: 10px;">@(v.ObjetoViaje?.ObjetoBus?.Placa ?? v.ObjetoViaje?.PlacaVehiculo ?? "Combi") (@(v.ObjetoViaje?.NombreConductor ?? v.ObjetoViaje?.ObjetoBus?.NombreConductor ?? "Conductor en Turno"))</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(v.Observaciones))
                {
                    <div class="t-row" style="align-items: baseline;">
                        <span class="t-key">Bajada / Obs:</span>
                        <span class="t-val" style="font-size: 9.5px; color: #d97706;">@v.Observaciones</span>
                    </div>
                }

                <!-- Caja destacada del número de asiento -->
                <div class="t-asiento-box">
                    <div class="t-asiento-label">ASIENTO ASIGNADO</div>
                    <div class="t-asiento-val">#@v.NumeroAsiento</div>
                </div>

                <hr class="t-dotted" />

                <!-- Totales -->
                <div class="t-totales-box">
                    @if (esReserva)
                    {
                        <div class="t-total-sub">
                            <span>Estado Reserva:</span>
                            <strong style="color: #d97706;">PENDIENTE DE PAGO</strong>
                        </div>
                        <hr />
                        <div class="t-total-final">
                            <span class="t-total-final-lbl">MONTO A PAGAR</span>
                            <span class="t-total-final-val reserva-val">S/ @v.PrecioPagado.ToString("N2")</span>
                        </div>
                    }
                    else
                    {
                        <div class="t-total-sub">
                            <span>Op. Gravada (Subtotal):</span>
                            <strong>S/ @subtotalV.ToString("N2")</strong>
                        </div>
                        <div class="t-total-sub">
                            <span>I.G.V. (18%):</span>
                            <strong>S/ @igvV.ToString("N2")</strong>
                        </div>
                        <hr />
                        <div class="t-total-final">
                            <span class="t-total-final-lbl">TOTAL PAGADO</span>
                            <span class="t-total-final-val">S/ @v.PrecioPagado.ToString("N2")</span>
                        </div>
                    }
                </div>

                <!-- Código de barras -->
                <div class="t-barcode-box">
                    <svg id="barcodeTermal_@v.Id_Venta"></svg>
                    <div class="t-barcode-text">*@serieCorrelativoTicket*</div>
                </div>

                <div class="t-footer-msg">
                    @if (esReserva)
                    {
                        <text>
                            <strong>AVISO DE RESERVA:</strong> Conserve este ticket. Debe confirmar y abonar su pasaje en agencia antes de la hora de salida.<br>
                            ¡Gracias por viajar con Tours Chota Express!
                        </text>
                    }
                    else
                    {
                        <text>
                            Representación impresa del Comprobante Electrónico SEE-SUNAT.<br>
                            Consulte su validez en www.sunat.gob.pe<br>
                            ¡Tours Chota Express le desea un excelente viaje!
                        </text>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ======================================================== -->
    <!-- 2. FORMATO FORMAL A4 (OPCIONAL, OCULTO POR DEFECTO)      -->
    <!-- ======================================================== -->
    <div class="doc-a4-container" id="docA4Container">
        @foreach (var v in Model)
        {
            bool esFactura = (v.TipoComprobante == "Factura");
            bool esReserva = (v.Estado == "Reservado");
            string tipoTituloA4 = esReserva ? "CONSTANCIA DE RESERVA DE PASAJE" : (esFactura ? "FACTURA ELECTRÓNICA" : "BOLETA DE VENTA ELECTRÓNICA");
            string serieA4 = esReserva ? "RES" : (esFactura ? "F001" : "B001");
            string correlativoA4 = v.Id_Venta.ToString("D8");
            string serieCorrelativoA4 = $"{serieA4}-{correlativoA4}";

            decimal subtotalA4 = Math.Round(v.PrecioPagado / 1.18m, 2);
            decimal igvA4 = v.PrecioPagado - subtotalA4;

            string clienteNombre = esFactura && !string.IsNullOrWhiteSpace(v.RazonSocialEmpresa)
                ? v.RazonSocialEmpresa
                : (v.ObjetoPasajero?.NombreCompleto ?? "CLIENTE GENERAL");

            string clienteDocTipo = esFactura ? "RUC" : (v.ObjetoPasajero?.TipoDocumento ?? "DNI");
            string clienteDocNum = esFactura && !string.IsNullOrWhiteSpace(v.RucEmpresa)
                ? v.RucEmpresa
                : (v.ObjetoPasajero?.NumeroDocumento ?? "-");

            string clienteDireccion = esFactura && !string.IsNullOrWhiteSpace(v.DireccionEmpresa)
                ? v.DireccionEmpresa
                : "-";

            string resumenHash = "";
            string rawHashData = $"{rucEmisor}|{(esFactura ? "01" : "03")}|{serieA4}|{correlativoA4}|{igvA4:0.00}|{v.PrecioPagado:0.00}|{v.FechaVenta:yyyy-MM-dd}|{clienteDocNum}";
            using (var sha = System.Security.Cryptography.SHA256.Create())
            {
                byte[] hashBytes = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(rawHashData));
                resumenHash = Convert.ToBase64String(hashBytes).Substring(0, 27) + "=";
            }

            string qrPayload = $"{rucEmisor}|{(esFactura ? "01" : "03")}|{serieA4}|{correlativoA4}|{igvA4:0.00}|{v.PrecioPagado:0.00}|{v.FechaVenta:yyyy-MM-dd}|{(esFactura ? "6" : "1")}|{clienteDocNum}|{resumenHash}|";
            string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&margin=0&data={Uri.EscapeDataString(qrPayload)}";

            <div class="doc-a4">
                <div class="a4-header">
                    <div class="box-emisor">
                        <div class="emisor-title">@empresaEmisor</div>
                        <div class="emisor-comercial">@nombreComercial</div>
                        <div class="emisor-dir"><strong>Dirección Fiscal:</strong> @direccionEmisor</div>
                        <div class="emisor-extra" style="font-size:0.75rem; color:#222; margin-top:3px;">
                            <strong>Agencias & Teléfonos:</strong>
                            @string.Join(" • ", agencias.Select(a => $"{a.Ciudad}: {a.Dir} (Cel. {a.Tel})"))
                        </div>
                    </div>
                    <div class="box-sunat">
                        <div class="sunat-ruc">R.U.C. N° @rucEmisor</div>
                        <div class="sunat-doc-type">@tipoTituloA4</div>
                        <div class="sunat-number">N° @serieCorrelativoA4</div>
                    </div>
                </div>

                <div class="box-customer">
                    <div class="customer-grid">
                        <div class="customer-item"><strong>Señor(es):</strong> @clienteNombre</div>
                        <div class="customer-item"><strong>Fecha Emisión:</strong> @v.FechaVenta.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        <div class="customer-item"><strong>@(clienteDocTipo):</strong> @clienteDocNum</div>
                        <div class="customer-item"><strong>Estado:</strong> @(esReserva ? "RESERVADO (PENDIENTE DE PAGO)" : "PAGADO")</div>
                        <div class="customer-item"><strong>Dirección:</strong> @clienteDireccion</div>
                        <div class="customer-item"><strong>Forma de Pago:</strong> @(esReserva ? "Pendiente" : "Contado")</div>
                        <div class="customer-item"><strong>Tipo Moneda:</strong> SOLES (PEN)</div>
                        <div class="customer-item"><strong>Operación:</strong> Venta Pasaje Terrestre</div>
                    </div>
                </div>

                <div class="box-transporte">
                    <div class="transporte-title"><i class="fa-solid fa-van-shuttle me-1"></i> DETALLES DEL SERVICIO DE TRANSPORTE TERRESTRE</div>
                    <div class="transporte-grid">
                        <div><strong>Origen:</strong> @(v.ObjetoViaje?.ObjetoRuta?.Origen?.ToUpper() ?? "CHOTA")</div>
                        <div><strong>Destino:</strong> @(v.ObjetoViaje?.ObjetoRuta?.Destino?.ToUpper() ?? "CHICLAYO")</div>
                        <div><strong>Salida:</strong> @(v.ObjetoViaje?.FechaHoraSalida.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</div>
                        <div><strong>Asiento:</strong> <span class="badge-asiento">ASIENTO #@v.NumeroAsiento</span></div>
                        <div><strong>Vehículo:</strong> @(v.ObjetoViaje?.ObjetoBus?.Placa ?? v.ObjetoViaje?.PlacaVehiculo ?? "Combi")</div>
                        <div><strong>Conductor:</strong> @(v.ObjetoViaje?.NombreConductor ?? v.ObjetoViaje?.ObjetoBus?.NombreConductor ?? "En Turno")</div>
                    </div>
                </div>

                <div class="box-items">
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th style="width:6%;text-align:center;">Item</th>
                                <th style="width:14%;text-align:center;">Cód. SUNAT</th>
                                <th style="width:8%;text-align:center;">Cant.</th>
                                <th style="width:8%;text-align:center;">U.M.</th>
                                <th style="width:40%;text-align:left;">Descripción</th>
                                <th style="width:12%;text-align:right;">V. Unitario</th>
                                <th style="width:12%;text-align:right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align:center;">1</td>
                                <td style="text-align:center;font-family:monospace;">78111802</td>
                                <td style="text-align:center;">1.00</td>
                                <td style="text-align:center;">ZZ</td>
                                <td style="text-align:left;">
                                    SERVICIO DE TRANSPORTE: @(v.ObjetoViaje?.ObjetoRuta?.Origen?.ToUpper()) A @(v.ObjetoViaje?.ObjetoRuta?.Destino?.ToUpper()) | ASIENTO #@v.NumeroAsiento | PASAJERO: @(v.ObjetoPasajero?.NombreCompleto?.ToUpper())
                                </td>
                                <td style="text-align:right;">S/ @subtotalA4.ToString("N2")</td>
                                <td style="text-align:right;">S/ @subtotalA4.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="middle-section">
                    <div class="left-notes">
                        <div class="monto-letras">@NumeroALetrasHelper.Convertir(v.PrecioPagado)</div>
                        <div class="adicional-title">INFORMACIÓN ADICIONAL</div>
                        <hr class="adicional-divider" />
                        <div class="adicional-details">
                            <div class="adicional-obs-grid">
                                <div class="adicional-label">OBSERVACIONES:</div>
                                <div>
                                    <div>PASAJERO: @(v.ObjetoPasajero?.NombreCompleto) (DOC: @v.ObjetoPasajero?.NumeroDocumento)</div>
                                    @if (!string.IsNullOrWhiteSpace(v.Observaciones))
                                    {
                                        <div>DETALLE / BAJADA: @v.Observaciones</div>
                                    }
                                    <div>ATENDIDO POR: @(v.ObjetoUsuario?.Name ?? "AGENCIA CHOTA")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="right-totals">
                        <div class="total-row"><span class="total-label">Op. Gravadas:</span><span class="total-line-val">S/ @subtotalA4.ToString("N2")</span></div>
                        <div class="total-row"><span class="total-label">I.G.V. (18%):</span><span class="total-line-val">S/ @igvA4.ToString("N2")</span></div>
                        <div class="total-row total-final"><span class="total-label">Importe Total:</span><span class="total-line-val">S/ @v.PrecioPagado.ToString("N2")</span></div>
                    </div>
                </div>

                <hr class="page-divider" />

                <div class="footer-section">
                    <div class="box-hash">
                        <div><strong>Código Hash:</strong> @resumenHash</div>
                        <div>Representación Impresa del Comprobante Electrónico SEE-SUNAT.</div>
                        <div style="font-size:0.73rem;color:#555;margin-top:4px;">
                            Autorizado mediante Resolución de Superintendencia N° 034-005-0005315/SUNAT.<br>
                            Consulte validez en: <strong>www.sunat.gob.pe</strong>
                        </div>
                    </div>
                    <div class="box-qr">
                        <img src="@qrUrl" alt="QR SUNAT" />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- JAVASCRIPT: GENERACIÓN DE BARRAS & AUTO-IMPRESIÓN DEL TICKET -->
    <script>
        // Renderizar códigos de barras para cada boleto
        @foreach (var v in Model)
        {
            bool esReservaB = (v.Estado == "Reservado");
            bool esFacturaB = (v.TipoComprobante == "Factura");
            string codBarcode = esReservaB ? $"RES-{v.Id_Venta:D8}" : (esFacturaB ? $"F001-{v.Id_Venta:D8}" : (v.TipoComprobante == "Ticket" ? $"T001-{v.Id_Venta:D8}" : $"B001-{v.Id_Venta:D8}"));
            <text>
            try {
                JsBarcode("#barcodeTermal_@v.Id_Venta", "@codBarcode", {
                    format: "CODE128",
                    width: 1.2,
                    height: 32,
                    displayValue: false,
                    margin: 0,
                    background: "#ffffff",
                    lineColor: "#000000"
                });
            } catch(e) {
                console.error("Barcode error @v.Id_Venta:", e);
            }
            </text>
        }

        // Alternar vista en pantalla entre Ticket Térmico y A4
        function mostrarVista(vista) {
            const ticketContainer = document.getElementById('ticketsTermalContainer');
            const docA4Container = document.getElementById('docA4Container');
            const tabA4 = document.getElementById('tabBtnA4');
            const tabTermal = document.getElementById('tabBtnTermal');

            if (vista === 'termal') {
                docA4Container.style.display = 'none';
                ticketContainer.style.display = 'flex';
                tabTermal.classList.add('active');
                tabA4.classList.remove('active');
                document.body.classList.remove('printing-a4');
            } else {
                docA4Container.style.display = 'flex';
                ticketContainer.style.display = 'none';
                tabA4.classList.add('active');
                tabTermal.classList.remove('active');
                document.body.classList.add('printing-a4');
            }
        }

        // Imprimir Ticket Térmico (Formato POS 80mm)
        function imprimirTermal() {
            document.body.classList.remove('printing-a4');
            mostrarVista('termal');
            setTimeout(function () {
                window.print();
            }, 150);
        }

        // AUTO-IMPRESIÓN INMEDIATA AL ABRIR LA PÁGINA
        window.addEventListener('DOMContentLoaded', function () {
            // Se activa automáticamente el cuadro de impresión para el ticket térmico
            setTimeout(function () {
                imprimirTermal();
            }, 380);
        });
    </script>
</body>
</html>
