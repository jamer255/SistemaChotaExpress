@model IEnumerable<SistemaChotaExpress.Controllers.VentaController.ViajeConDisponibilidad>
@{
    ViewData["Title"] = "Venta de Pasajes y Salidas";
    var selectedViaje = ViewBag.SelectedViaje as SistemaChotaExpress.Models.Viaje;
    var asientosOcupados = ViewBag.AsientosOcupados as List<int> ?? new List<int>();
    var asientosReservados = ViewBag.AsientosReservados as List<int> ?? new List<int>();
}

<style>
    /* Inline Glassmorphic Calendar Styles */
    .calendar-container {
        background: rgba(15, 14, 19, 0.6);
        border: 1px solid var(--border-glass);
        border-radius: 14px;
        padding: 12px;
    }
    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .calendar-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: #fff;
    }
    .calendar-nav-btn {
        background: none;
        border: none;
        color: var(--primary);
        font-size: 0.85rem;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
        transition: background 0.2s;
    }
    .calendar-nav-btn:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        text-align: center;
    }
    .calendar-day-header {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-weight: 600;
        padding-bottom: 4px;
    }
    .calendar-day-cell {
        font-size: 0.8rem;
        padding: 6px 0;
        cursor: pointer;
        border-radius: 50%;
        color: #e1e1e6;
        transition: all 0.2s;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .calendar-day-cell:hover:not(.empty-cell):not(.selected-cell) {
        background: rgba(255, 255, 255, 0.08);
    }
    .calendar-day-cell.selected-cell {
        background: var(--primary);
        color: #fff;
        font-weight: bold;
        box-shadow: 0 0 10px rgba(243, 112, 33, 0.4);
    }
    .calendar-day-cell.today-cell:not(.selected-cell) {
        border: 1px solid var(--primary);
        color: var(--primary-light);
    }
    .calendar-day-cell.empty-cell {
        cursor: default;
    }

    .sidebar-card {
        background: var(--dark-card);
        border: 1px solid var(--border-glass);
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 16px;
    }
    .sidebar-section-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }
    .hour-pill-btn {
        border-top-left-radius: 20px !important;
        border-bottom-left-radius: 20px !important;
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        transition: all 0.2s ease-in-out;
    }
    .btn-glass-pill {
        background: rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .btn-glass-pill:hover {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }
    .btn-teal-active {
        background: #10b981 !important;
        color: #ffffff !important;
        border-color: #10b981 !important;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }
    .btn-pill-control {
        border-radius: 0 !important;
        padding: 4px 7px;
        font-size: 0.72rem;
        font-weight: bold;
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .btn-pill-minus {
        background: rgba(220, 38, 38, 0.2);
        color: #f87171;
        border-color: rgba(220, 38, 38, 0.3);
    }
    .btn-pill-minus:hover {
        background: #dc2626;
        color: #ffffff;
    }
    .btn-pill-plus {
        border-top-right-radius: 20px !important;
        border-bottom-right-radius: 20px !important;
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.3);
    }
    .btn-pill-plus:hover {
        background: #f59e0b;
        color: #ffffff;
    }
    .hour-container {
        max-height: 140px;
        overflow-y: auto;
        padding-right: 4px;
    }
    .big-price-text {
        font-size: 2.2rem;
        font-weight: 900;
        color: #198754;
    }
    .route-pill-btn {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.05);
        color: #e1e1e6;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        transition: all 0.2s;
    }
    .route-pill-btn:hover, .route-pill-btn.active {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
    }
    .nav-tabs-custom .nav-link {
        color: #adb5bd;
        border: 1px solid transparent;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 10px 10px 0 0;
    }
    .nav-tabs-custom .nav-link.active {
        color: #fff;
        background: var(--dark-card);
        border-color: var(--border-glass) var(--border-glass) transparent;
    }
    .panel-cuadro {
        background: rgba(25, 24, 32, 0.7);
        border: 1px solid var(--border-glass);
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 14px;
    }
    .cuadro-title {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["BienvenidaLogin"] != null)
{
    var nombreUsuario = TempData["BienvenidaLogin"]!.ToString();
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "¡Buenos días" : hora < 19 ? "¡Buenas tardes" : "¡Buenas noches";
    <div id="toastBienvenida" style="
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        min-width: 340px;
        max-width: 420px;
        background: linear-gradient(135deg, #1a1921 0%, #2a1f3d 100%);
        border: 1px solid rgba(243, 112, 33, 0.5);
        border-radius: 18px;
        box-shadow: 0 8px 40px rgba(243, 112, 33, 0.3), 0 2px 16px rgba(0,0,0,0.6);
        padding: 20px 24px;
        animation: slideInRight 0.5s cubic-bezier(.22,1,.36,1) forwards;
        overflow: hidden;">
        <!-- Barra de progreso -->
        <div id="toastProgressBar" style="
            position: absolute;
            bottom: 0; left: 0;
            height: 3px;
            width: 100%;
            background: linear-gradient(90deg, #f37021, #fbbf24);
            border-radius: 0 0 18px 18px;
            transform-origin: left;
            animation: shrinkBar 5s linear forwards;">
        </div>
        <div class="d-flex align-items-center gap-3">
            <div style="font-size: 2.6rem; line-height:1; filter: drop-shadow(0 0 8px rgba(251,191,36,0.6));">👋</div>
            <div class="flex-grow-1">
                <div style="font-size: 0.78rem; color: #f59e0b; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px;">
                    Chota Express — Módulo de Ventas
                </div>
                <div style="font-size: 1.1rem; font-weight: 900; color: #ffffff; line-height: 1.2;">
                    @saludo, <span style="color: #f37021;">@nombreUsuario</span>! 🎉
                </div>
                <div style="font-size: 0.82rem; color: #cbd5e1; margin-top: 4px;">
                    Listo para vender boletos hoy 🚐💨 ¡A darle con todo!
                </div>
            </div>
            <button onclick="cerrarToast()" style="
                background: none; border: none; color: #6b7280;
                font-size: 1.1rem; cursor: pointer; padding: 0 0 0 8px;
                transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#6b7280'">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    </div>

    <style>
        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(120px) scale(0.95); }
            to   { opacity: 1; transform: translateX(0) scale(1); }
        }
        @@keyframes slideOutRight {
            from { opacity: 1; transform: translateX(0) scale(1); }
            to   { opacity: 0; transform: translateX(120px) scale(0.95); }
        }
        @@keyframes shrinkBar {
            from { transform: scaleX(1); }
            to   { transform: scaleX(0); }
        }
    </style>

    <script>
        function cerrarToast() {
            const t = document.getElementById('toastBienvenida');
            if (t) {
                t.style.animation = 'slideOutRight 0.4s cubic-bezier(.22,1,.36,1) forwards';
                setTimeout(() => t.remove(), 400);
            }
        }
        // Auto-cierre a los 5 segundos
        setTimeout(cerrarToast, 5000);
    </script>
}

<!-- Unified Ticket Sales Screen -->
<div class="row g-4">
    <!-- LEFT SIDEBAR -->
    <div class="col-xl-3 col-lg-4 col-md-5 col-12">
        <form method="get" id="searchFilterForm" class="m-0" action="@Url.Action("BuscarViajes")">
            <!-- Search Date and Selected Trip hidden inputs -->
            <input type="hidden" name="fecha" id="fechaInput" value="@ViewBag.SelectedFecha" />
            @if (selectedViaje != null)
            {
                <input type="hidden" name="viajeId" id="filtroViajeId" value="@selectedViaje.Id_Viaje" />
            }

            <!-- Selección de Origen y Destino -->
            <div class="sidebar-card border-warning">
                <div class="sidebar-section-title text-warning fw-bold fs-7 mb-2">
                    <i class="fa-solid fa-route me-1"></i> SELECCIÓN DE RUTA
                </div>

                <div class="mb-2.5">
                    <label class="form-label text-warning fw-bold fs-8 mb-1">DESDE (ORIGEN):</label>
                    <select name="origen" id="origenSelect" class="form-select bg-dark-input fw-bold border-glass-field fs-8 select-filter" required>
                        <option value="">-- Seleccionar Origen --</option>
                        @if (ViewBag.LugaresDisponibles != null)
                        {
                            foreach (string lugar in (List<string>)ViewBag.LugaresDisponibles)
                            {
                                var isSel = string.Equals(lugar.Trim(), ViewBag.SelectedOrigen?.ToString()?.Trim(), StringComparison.OrdinalIgnoreCase);
                                if (isSel)
                                {
                                    <option value="@lugar" selected="selected" class="fw-bold">@lugar</option>
                                }
                                else
                                {
                                    <option value="@lugar">@lugar</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="mb-2.5">
                    <label class="form-label text-warning fw-bold fs-8 mb-1">HACIA (DESTINO):</label>
                    <select name="destino" id="destinoSelect" class="form-select bg-dark-input fw-bold border-glass-field fs-8 select-filter" required>
                        <option value="">-- Seleccionar Destino --</option>
                        @if (ViewBag.LugaresDisponibles != null)
                        {
                            foreach (string lugar in (List<string>)ViewBag.LugaresDisponibles)
                            {
                                var isSel = string.Equals(lugar.Trim(), ViewBag.SelectedDestino?.ToString()?.Trim(), StringComparison.OrdinalIgnoreCase);
                                if (isSel)
                                {
                                    <option value="@lugar" selected="selected" class="fw-bold">@lugar</option>
                                }
                                else
                                {
                                    <option value="@lugar">@lugar</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary btn-orange-solid flex-grow-1 py-2 fw-bold fs-8">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Filtrar Ruta
                    </button>
                    <a href="@Url.Action("BuscarViajes", new { reset = true })" class="btn btn-sm btn-outline-secondary border-glass-btn py-2 px-2.5 text-white" title="Limpiar Filtros">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>

        <!-- Calendario de Salidas -->
        <div class="sidebar-card">
            <div class="sidebar-section-title text-white fw-bold fs-8 mb-2">
                <i class="fa-solid fa-calendar-days text-warning me-1"></i> FECHA DE VIAJE
            </div>
            <div class="calendar-container" id="calendarWidget">
                <!-- Calendar generated dynamically via Javascript -->
            </div>
            <div class="text-center mt-2">
                <button type="button" class="btn btn-sm btn-link text-warning fs-9" id="btnGoToToday"><i class="fa-solid fa-circle-dot"></i> Ir a Hoy</button>
            </div>
        </div>
    </div>

    <!-- RIGHT MAIN CONTENT (PASO 2: SELECCIONAR HORARIO & VENDER) -->
    <div class="col-xl-9 col-lg-8 col-md-7 col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 text-white fw-bold m-0"><i class="fa-solid fa-cash-register text-primary me-2"></i> Módulo de Ventas & Salidas</h1>
            <span class="badge bg-warning text-dark fs-8 fw-bold"><i class="fa-regular fa-calendar me-1"></i> Fecha: @ViewBag.SelectedFecha</span>
        </div>

        <div class="sales-content-area">
            <!-- VENTA DE PASAJES Y MAPA DE ASIENTOS -->
            <div id="capaVenta">
                <!-- SELECCIONAR HORARIO (24 HORAS) -->
                @{
                    var viajesEnMismaHora = ViewBag.ViajesEnMismaHora as List<SistemaChotaExpress.Controllers.VentaController.ViajeConDisponibilidad>;
                    DateTime fechaBase = DateTime.Parse(ViewBag.SelectedFecha as string ?? DateTime.Today.ToString("yyyy-MM-dd"));
                    bool hasActiveRoute = !string.IsNullOrWhiteSpace(ViewBag.SelectedOrigen as string) && !string.IsNullOrWhiteSpace(ViewBag.SelectedDestino as string);
                }

                @if (!hasActiveRoute)
                {
                    <div class="alert alert-dark border-warning text-warning p-4 text-center fs-7 shadow-lg my-3" role="alert">
                        <i class="fa-solid fa-route fa-2x d-block mb-2 text-warning"></i>
                        <strong class="fs-6 d-block mb-1">SELECCIÓN DE RUTA REQUERIDA</strong>
                        Por favor seleccione el <strong>Origen</strong> y <strong>Destino</strong> en el panel lateral para ver los horarios y salidas disponibles.
                    </div>
                }
                else
                {
                    <div class="card bg-dark text-white border-glass p-3 mb-3">
                        <div class="sidebar-section-title mb-2 d-flex justify-content-between align-items-center">
                            <span class="text-warning fw-bold fs-7">
                                <i class="fa-regular fa-clock me-1 text-warning"></i> HORARIOS DISPONIBLES: <span class="text-white text-uppercase">@ViewBag.SelectedOrigen → @ViewBag.SelectedDestino</span>
                            </span>
                            <small class="text-muted fs-9">24 franjas horarias</small>
                        </div>
                        <div class="d-flex flex-wrap gap-1.5 hour-container">
                            @for (int h = 0; h < 24; h++)
                            {
                                var horaSlot = fechaBase.Date.AddHours(h);
                                var horaTexto = horaSlot.ToString("hh:mm tt");
                                var tripsEnHora = Model != null 
                                    ? Model.Where(m => m.Viaje.FechaHoraSalida.Hour == h).ToList() 
                                    : new List<SistemaChotaExpress.Controllers.VentaController.ViajeConDisponibilidad>();
                                var cantidadVehiculos = tripsEnHora.Count;

                                if (cantidadVehiculos > 0)
                                {
                                    var itemSeleccionado = selectedViaje != null 
                                        ? tripsEnHora.FirstOrDefault(item => item.Viaje.Id_Viaje == selectedViaje.Id_Viaje) 
                                        : null;

                                    var isSelected = itemSeleccionado != null;
                                    var targetTrip = (itemSeleccionado ?? tripsEnHora.First()).Viaje;

                                    <a href="@Url.Action("BuscarViajes", new { origen = ViewBag.SelectedOrigen, destino = ViewBag.SelectedDestino, fecha = ViewBag.SelectedFecha, viajeId = targetTrip.Id_Viaje })#bookingSection" 
                                       class="btn hour-pill-btn mb-1 me-1 @(isSelected ? "btn-teal-active shadow-lg" : "btn-glass-pill")"
                                       title="Salida a las @horaTexto (@cantidadVehiculos vehículo(s))">
                                        <i class="fa-regular fa-clock me-1 fs-9"></i>@horaTexto
                                    </a>
                                }
                                else
                                {
                                    <span class="btn hour-pill-btn btn-glass-pill text-muted opacity-75 mb-1 me-1">
                                        <i class="fa-regular fa-clock me-1 text-muted fs-9"></i>@horaTexto
                                    </span>
                                }
                            }
                        </div>
                    </div>
                }

                @if (selectedViaje != null)
                {
                    @if (viajesEnMismaHora != null && viajesEnMismaHora.Count > 0)
                    {
                        <!-- BARRA PROMINENTE DE SELECCIÓN DE VEHÍCULOS / COMBIS -->
                        <div class="card bg-dark text-white border-glass p-3 mb-3 shadow-lg">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <span class="fs-8 font-weight-700 text-warning">
                                    <i class="fa-solid fa-van-shuttle me-1 text-warning"></i> SELECCIONAR VEHÍCULO / COMBI (SALIDA @selectedViaje.FechaHoraSalida.ToString("hh:mm tt")):
                                </span>
                                <span class="fs-9 text-muted font-monospace">(@viajesEnMismaHora.Count Vehículo(s) registrado(s))</span>
                            </div>
                            
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @for (int idx = 0; idx < viajesEnMismaHora.Count; idx++)
                                {
                                    var itemV = viajesEnMismaHora[idx];
                                    var isThisSelected = itemV.Viaje.Id_Viaje == selectedViaje.Id_Viaje;
                                    var numCombi = idx + 1;
                                    var nombreVeh = $"Combi {numCombi:D2}";
                                    var chofer = string.IsNullOrWhiteSpace(itemV.Viaje.NombreConductor) ? "Sin Conductor" : itemV.Viaje.NombreConductor;

                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("BuscarViajes", new { origen = ViewBag.SelectedOrigen, destino = ViewBag.SelectedDestino, fecha = ViewBag.SelectedFecha, viajeId = itemV.Viaje.Id_Viaje })#bookingSection"
                                           class="btn @(isThisSelected ? "btn-teal-active shadow-lg text-white font-weight-700" : "btn-outline-light border-glass-btn opacity-85") fs-8 py-1.5 px-3">
                                            <i class="fa-solid fa-van-shuttle me-1 text-warning"></i>
                                            <strong>@nombreVeh</strong> <small class="opacity-75">(@chofer)</small>
                                            @if (isThisSelected)
                                            {
                                                <span class="badge bg-white text-dark ms-1 fs-9">Vendiéndose</span>
                                            }
                                        </a>

                                        @if (viajesEnMismaHora.Count > 1)
                                        {
                                            <form asp-action="EliminarSalida" method="post" class="d-inline m-0" onsubmit="return confirm('¿Está seguro de que desea eliminar la salida de @nombreVeh?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="origen" value="@ViewBag.SelectedOrigen" />
                                                <input type="hidden" name="destino" value="@ViewBag.SelectedDestino" />
                                                <input type="hidden" name="fecha" value="@ViewBag.SelectedFecha" />
                                                <input type="hidden" name="viajeId" value="@itemV.Viaje.Id_Viaje" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-glass-btn h-100 px-2" title="Eliminar este vehículo de la hora @selectedViaje.FechaHoraSalida.ToString("hh:mm tt")">
                                                    <i class="fa-solid fa-trash-can fs-9"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }

                                <!-- Botón + Agregar Otra Combi en esta Hora -->
                                <form asp-action="AgregarSalidaAdicional" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="viajeId" value="@selectedViaje.Id_Viaje" />
                                    <input type="hidden" name="origen" value="@ViewBag.SelectedOrigen" />
                                    <input type="hidden" name="destino" value="@ViewBag.SelectedDestino" />
                                    <input type="hidden" name="fecha" value="@selectedViaje.FechaHoraSalida.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="hora" value="@selectedViaje.FechaHoraSalida.Hour" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning border-glass-btn py-1.5 px-3 fs-9" title="Agregar otra combi a las @selectedViaje.FechaHoraSalida.ToString("hh:mm tt")">
                                        <i class="fa-solid fa-plus me-1"></i> Agregar Combi @(viajesEnMismaHora.Count + 1)
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    var combiIndexPos = (viajesEnMismaHora != null) ? viajesEnMismaHora.FindIndex(v => v.Viaje.Id_Viaje == selectedViaje.Id_Viaje) + 1 : 1;
                    if (combiIndexPos <= 0) combiIndexPos = 1;
                    var displayNombreCombi = $"COMBI {combiIndexPos:D2}";
                    <!-- SEAT MAP & REGISTRATION AREA -->
                    <div class="row g-4" id="bookingSection">
                        <!-- Bus Seats Cabin Column -->
                        <div class="col-lg-5 col-12">
                            <div class="card bg-dark text-white border-glass p-3">
                                <div class="sidebar-section-title mb-2 d-flex flex-wrap align-items-center justify-content-between gap-1">
                                    <div>
                                        @{
                                            var rutaDisplay = !string.IsNullOrWhiteSpace(ViewBag.SelectedOrigen as string) && !string.IsNullOrWhiteSpace(ViewBag.SelectedDestino as string)
                                                ? $"{ViewBag.SelectedOrigen.ToString().ToUpper()} → {ViewBag.SelectedDestino.ToString().ToUpper()}"
                                                : "RUTA LIBRE";
                                            var placaActual = string.IsNullOrWhiteSpace(selectedViaje.PlacaVehiculo) ? "S/P" : selectedViaje.PlacaVehiculo.ToUpper();
                                        }
                                        <i class="fa-solid fa-van-shuttle me-1 text-primary"></i> <strong>@displayNombreCombi</strong>
                                        <span class="badge bg-warning text-dark ms-1 fs-9 font-monospace">@rutaDisplay</span>
                                    </div>
                                </div>
                                <!-- Panel DATOS DEL VEHÍCULO: Placa + Conductor -->
                                <div class="row g-2 mb-2">
                                    <!-- Placa -->
                                    <div class="col-12">
