                </div>
                <div class="modal-footer border-secondary py-2">
                    <button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-warning text-white fw-bold px-4" style="background-color: #f7941d; border: none; border-radius: 8px;">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Crear Salida
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (selectedViaje != null)
{
    <!-- Modal 2: Editar Conductor Actual -->
    <div class="modal fade" id="modalCambiarConductor" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-dark text-white border-glass shadow-lg">
                <div class="modal-header border-secondary py-2">
                    <h6 class="modal-title fw-bold text-warning">
                        <i class="fa-solid fa-id-card me-2"></i> Cambiar Conductor
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="ActualizarConductorViaje" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="viajeId" value="@selectedViaje.Id_Viaje" />
                    <input type="hidden" name="origen" value="@ViewBag.SelectedOrigen" />
                    <input type="hidden" name="destino" value="@ViewBag.SelectedDestino" />
                    <input type="hidden" name="fecha" value="@ViewBag.SelectedFecha" />
                    <div class="modal-body py-3">
                        <label class="form-label text-muted fs-8 font-weight-600">Nombre del Conductor (Chofer)</label>
                        <input type="text" name="nombreConductor" class="form-control bg-dark-input text-white border-glass-field" 
                               value="@(selectedViaje.NombreConductor ?? selectedViaje.ObjetoBus?.NombreConductor ?? "")" 
                               placeholder="Ej. Carlos Gómez" required />
                    </div>
                    <div class="modal-footer border-secondary py-2">
                        <button type="submit" class="btn btn-sm btn-warning text-white w-100 fw-bold" style="background-color: #f7941d; border: none; border-radius: 8px;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Nombre
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 3: Detalle y Anulación Directa de Asiento Ocupado (Al dar clic al asiento ocupado) -->
    <div class="modal fade" id="modalDetalleAsientoOcupado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-dark text-white border-glass shadow-lg">
                <div class="modal-header border-secondary py-2">
                    <h6 class="modal-title fw-bold text-warning">
                        <i class="fa-solid fa-chair me-2"></i> Asiento #<span id="modalAsientoNumero">--</span> (<span id="modalAsientoEstado">Ocupado</span>)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-2 fs-8">
                        <span class="text-muted d-block fs-9">Pasajero:</span>
                        <strong id="modalPasajeroNombre" class="text-white">--</strong>
                    </div>
                    <div class="mb-2 fs-8">
                        <span class="text-muted d-block fs-9">Documento:</span>
                        <span id="modalPasajeroDoc" class="font-monospace text-warning">--</span>
                    </div>
                    <div class="mb-2 fs-8">
                        <span class="text-muted d-block fs-9">Comprobante / Costo:</span>
                        <span id="modalPasajeroComp" class="text-success font-monospace fw-bold">--</span>
                    </div>
                </div>
                <div class="modal-footer border-secondary p-2 d-flex flex-column gap-1">
                    <form asp-action="AnularVenta" method="post" id="formAnularAsientoModal" class="w-100 m-0" onsubmit="return confirm('¿Está seguro de ANULAR la venta de este asiento? El asiento se liberará inmediatamente.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idVenta" id="modalIdVentaInput" value="0" />
                        <input type="hidden" name="origen" value="@ViewBag.SelectedOrigen" />
                        <input type="hidden" name="destino" value="@ViewBag.SelectedDestino" />
                        <input type="hidden" name="fecha" value="@ViewBag.SelectedFecha" />
                        <input type="hidden" name="viajeId" value="@(selectedViaje.Id_Viaje)" />
                        <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold py-2 fs-8" style="background-color: #dc3545; border: none; border-radius: 8px;">
                            <i class="fa-solid fa-ban me-1"></i> ANULAR VENTA / LIBERAR ASIENTO
                        </button>
                    </form>
                    <a href="#" id="modalVerTicketLink" class="btn btn-outline-light btn-sm w-100 py-1 fs-9 border-glass-btn">
                        <i class="fa-solid fa-receipt me-1"></i> Ver / Imprimir Ticket
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function limpiarFiltrosRuta() {
            window.location.href = "@Url.Action("BuscarViajes", new { reset = true })";
        }

        document.addEventListener("DOMContentLoaded", function() {
            const origenSelect = document.getElementById("origenSelect");
            const destinoSelect = document.getElementById("destinoSelect");
            const searchFilterForm = document.getElementById("searchFilterForm");

            if (searchFilterForm && origenSelect && destinoSelect) {
                origenSelect.addEventListener("change", function() {
                    const orig = this.value ? this.value.trim() : "";
                    const dest = destinoSelect.value ? destinoSelect.value.trim() : "";
                    if (orig && dest && orig.toLowerCase() === dest.toLowerCase()) {
                        destinoSelect.value = "";
                    }
                });

                destinoSelect.addEventListener("change", function() {
                    const orig = origenSelect.value ? origenSelect.value.trim() : "";
                    const dest = this.value ? this.value.trim() : "";
                    if (orig && dest && orig.toLowerCase() === dest.toLowerCase()) {
                        alert("El origen y el destino no pueden ser la misma ciudad. Por favor elija un destino diferente.");
                        this.value = "";
                    }
                });
            }

            // Handle date integration
            const fechaInput = document.getElementById("fechaInput");
            const selectedDateStr = fechaInput.value; // yyyy-MM-dd

            let currentDate = new Date();
            if (selectedDateStr) {
                const parts = selectedDateStr.split('-');
                currentDate = new Date(parts[0], parts[1] - 1, parts[2]);
            }

            let displayYear = currentDate.getFullYear();
            let displayMonth = currentDate.getMonth();

            // Render calendar widget
            const calendarWidget = document.getElementById("calendarWidget");

            function getMonthName(monthIdx) {
                const months = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                return months[monthIdx];
            }

            function renderCalendar(year, month) {
                calendarWidget.innerHTML = "";

                // Header HTML
                const header = document.createElement("div");
                header.className = "calendar-header";
                header.innerHTML = `
                    <button type="button" class="calendar-nav-btn" id="prevMonthBtn"><i class="fa-solid fa-chevron-left"></i></button>
                    <span class="calendar-title">${getMonthName(month)} ${year}</span>
                    <button type="button" class="calendar-nav-btn" id="nextMonthBtn"><i class="fa-solid fa-chevron-right"></i></button>
                `;
                calendarWidget.appendChild(header);

                // Grid Container
                const grid = document.createElement("div");
                grid.className = "calendar-grid";

                // Days headers
                const daysAbbr = ["Lu", "Ma", "Mi", "Ju", "Vi", "Sa", "Do"];
                daysAbbr.forEach(abbr => {
                    const dayHeader = document.createElement("div");
                    dayHeader.className = "calendar-day-header";
                    dayHeader.innerText = abbr;
                    grid.appendChild(dayHeader);
                });

                // Calculate first day of the month and total days
                const firstDay = new Date(year, month, 1);
                let startOffset = firstDay.getDay() - 1;
                if (startOffset === -1) startOffset = 6; // Sunday

                const totalDays = new Date(year, month + 1, 0).getDate();

                // Append empty cells for offset
                for (let i = 0; i < startOffset; i++) {
                    const emptyCell = document.createElement("div");
                    emptyCell.className = "calendar-day-cell empty-cell";
                    grid.appendChild(emptyCell);
                }

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                const minDateAllowed = new Date(today);
                minDateAllowed.setDate(minDateAllowed.getDate() - 3);

                // Append actual days
                for (let day = 1; day <= totalDays; day++) {
                    const cell = document.createElement("div");
                    cell.className = "calendar-day-cell";
                    cell.innerText = day;

                    const cellDate = new Date(year, month, day);
                    cellDate.setHours(0, 0, 0, 0);

                    const cellDateString = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

                    if (cellDate < minDateAllowed) {
                        cell.classList.add("empty-cell");
                        cell.style.opacity = "0.3";
                        cell.style.cursor = "not-allowed";
                        cell.title = "No se permite emitir ventas con más de 3 días de antigüedad";
                    } else {
                        // Check if selected
                        if (selectedDateStr === cellDateString) {
                            cell.classList.add("selected-cell");
                        }

                        // Check if today
                        if (today.getDate() === day && today.getMonth() === month && today.getFullYear() === year) {
                            cell.classList.add("today-cell");
                        }

                        // Handle cell click
                        cell.addEventListener("click", function() {
                            fechaInput.value = cellDateString;
                            document.getElementById("searchFilterForm").submit();
                        });
                    }

                    grid.appendChild(cell);
                }

                calendarWidget.appendChild(grid);

                // Wire month navigation buttons
                document.getElementById("prevMonthBtn").addEventListener("click", function(e) {
                    e.stopPropagation();
                    let newMonth = month - 1;
                    let newYear = year;
                    if (newMonth < 0) {
                        newMonth = 11;
                        newYear--;
                    }
                    renderCalendar(newYear, newMonth);
                });

                document.getElementById("nextMonthBtn").addEventListener("click", function(e) {
                    e.stopPropagation();
                    let newMonth = month + 1;
                    let newYear = year;
                    if (newMonth > 11) {
                        newMonth = 0;
                        newYear++;
                    }
                    renderCalendar(newYear, newMonth);
                });
            }

            renderCalendar(displayYear, displayMonth);

            // Go to Today Button
            document.getElementById("btnGoToToday").addEventListener("click", function() {
                const today = new Date();
                const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
                fechaInput.value = todayStr;
                document.getElementById("searchFilterForm").submit();
            });

            // Booking form setup (Multi-Seat selection & shared RUC invoice)
            const bookingSection = document.getElementById("bookingSection");
            if (bookingSection) {
                const seats = document.querySelectorAll(".seat-box.seat-available");
                const selectedSeatLabel = document.getElementById("selectedSeatLabel");
                const seatAlert = document.getElementById("seatAlert");
                const seatSelectedIndicator = document.getElementById("seatSelectedIndicator");
                const containerPasajeros = document.getElementById("asientosPasajerosContainer");
                const counterAsientos = document.getElementById("counterAsientos");
                const btnVenderSubmit = document.getElementById("btnVenderSubmit");
                const btnReservarSubmit = document.getElementById("btnReservarSubmit");

                let selectedSeatsList = [];

                function calculateTotalSum() {
                    const priceInputs = document.querySelectorAll("input[name='preciosPagados']");
                    let totalSum = 0;
                    priceInputs.forEach(inp => {
                        let val = parseFloat(inp.value) || 0;
                        totalSum += val;
                    });
                    const priceDisplay = document.getElementById("priceDisplay");
                    const totalPasajesCount = document.getElementById("totalPasajesCount");
                    if (priceDisplay) {
                        priceDisplay.innerText = "S/ " + totalSum.toFixed(2);
                    }
                    if (totalPasajesCount) {
                        totalPasajesCount.innerText = `${priceInputs.length} pasaje(s)`;
                    }
                }

                function updatePassengerFormRows() {
                    containerPasajeros.innerHTML = "";

                    if (selectedSeatsList.length === 0) {
                        seatAlert.classList.remove("d-none");
                        seatSelectedIndicator.classList.add("d-none");
                        btnVenderSubmit.setAttribute("disabled", "true");
                        btnReservarSubmit.setAttribute("disabled", "true");
                        counterAsientos.textContent = "0 Asiento(s)";
                        containerPasajeros.innerHTML = '<p class="text-muted fs-8 text-center py-3 m-0"><i class="fa-solid fa-info-circle me-1"></i> Seleccione un asiento en el mapa interactivo para ingresar los datos del pasajero.</p>';
                        calculateTotalSum();
                        return;
                    }

                    seatAlert.classList.add("d-none");
                    seatSelectedIndicator.classList.remove("d-none");
                    btnVenderSubmit.removeAttribute("disabled");
                    btnReservarSubmit.removeAttribute("disabled");

                    selectedSeatsList.sort((a, b) => a - b);
                    selectedSeatLabel.innerText = selectedSeatsList.join(", ");
                    counterAsientos.textContent = `${selectedSeatsList.length} Asiento(s) Seleccionado(s)`;

                    let basePrice = parseFloat('@(selectedViaje?.Precio ?? 0)');
                    if (isNaN(basePrice) || basePrice < 0) basePrice = 0;

                    const lugaresList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LugaresDisponibles as List<string> ?? new List<string>()));
                    const selectedDestinoGlobal = "@(ViewBag.SelectedDestino ?? "")".trim().toLowerCase();
                    let destinosOptionsHtml = '';
                    lugaresList.forEach(l => {
                        const isSel = (l.trim().toLowerCase() === selectedDestinoGlobal) ? 'selected' : '';
                        destinosOptionsHtml += `<option value="${l}" ${isSel}>${l}</option>`;
                    });

                    selectedSeatsList.forEach((numSeat, idx) => {
                        const cardHtml = `
                            <div class="p-2.5 bg-dark border-glass rounded mb-2 border-start border-3 border-warning">
                                <input type="hidden" name="asientos" value="${numSeat}" />
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fs-8 fw-bold text-warning"><i class="fa-solid fa-chair me-1"></i> Asiento #${numSeat}</span>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="fs-9 text-muted">Precio S/</span>
                                        <input type="number" step="0.50" min="0" name="preciosPagados" class="form-control form-control-sm bg-dark-input text-success font-monospace fs-9 border-glass-field text-end seat-price-input" style="width: 85px;" value="0.00" required />
                                    </div>
                                </div>
                                <div class="row g-2 mb-1">
                                    <div class="col-4">
                                        <select name="tiposDocumento" id="tipoDoc_${numSeat}" class="form-select bg-dark-input text-white border-glass-field fs-9 py-1">
                                            <option value="DNI" selected>DNI</option>
                                            <option value="CE">C. Extranjería</option>
                                            <option value="PASAPORTE">Pasaporte</option>
                                        </select>
                                    </div>
                                    <div class="col-8">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="numerosDocumento" id="numDoc_${numSeat}" class="form-control bg-dark-input text-white border-glass-field font-monospace fs-9" placeholder="N° Documento" maxlength="15" />
                                            <button class="btn btn-warning py-0 px-2 fs-9" type="button" onclick="consultarDocAsiento(${numSeat})" title="Buscar Reniec">
                                                <i class="fa-solid fa-magnifying-glass"></i> Reniec
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-1.5">
                                    <input type="text" name="nombresCompletos" id="nombre_${numSeat}" class="form-control bg-dark-input text-white border-glass-field fs-9 py-1" placeholder="Nombres y Apellidos del Pasajero #${numSeat}" required />
                                </div>
                                <div class="d-flex align-items-center gap-1.5 bg-dark-card border-glass p-1.5 rounded">
                                    <span class="fs-9 text-warning text-nowrap fw-bold"><i class="fa-solid fa-location-dot me-1"></i>Destino / Bajada:</span>
                                    <select name="destinosPasajeros" class="form-select form-select-sm bg-dark-input text-white border-glass-field fs-9 py-0.5">
                                        ${destinosOptionsHtml}
                                    </select>
                                </div>
                            </div>
                        `;
                        containerPasajeros.insertAdjacentHTML('beforeend', cardHtml);
                    });

                    // Eventos para auto-formatear a 2 decimales en blur y recalcular suma total en tiempo real
                    const priceInputs = containerPasajeros.querySelectorAll(".seat-price-input");
                    priceInputs.forEach(inp => {
                        inp.addEventListener("blur", function() {
                            if (this.value !== "") {
                                this.value = parseFloat(this.value).toFixed(2);
                            }
                            calculateTotalSum();
                        });
                        inp.addEventListener("input", function() {
                            calculateTotalSum();
                        });
                    });

                    calculateTotalSum();
                }

                // Handle occupied/reserved seat clicks to pop up detail & cancellation modal
                @{
                    var listVentasActivas = ViewBag.VentasActivasDetalle as List<SistemaChotaExpress.Models.Venta> ?? new List<SistemaChotaExpress.Models.Venta>();
                    var ventasJsonDto = listVentasActivas.Select(v => new {
                        idVenta = v.Id_Venta,
                        numeroAsiento = v.NumeroAsiento,
                        nombrePasajero = v.ObjetoPasajero?.NombreCompleto ?? "PASAJERO",
                        docPasajero = $"{v.ObjetoPasajero?.TipoDocumento}: {v.ObjetoPasajero?.NumeroDocumento}",
                        comprobante = $"{v.TipoComprobante} {(string.IsNullOrEmpty(v.RucEmpresa) ? "" : $" (RUC: {v.RucEmpresa})")}",
                        precio = v.PrecioPagado.ToString("0.00"),
                        estado = v.Estado
                    }).ToList();
                }

                const ventasActivasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasJsonDto));

                const occupiedSeats = document.querySelectorAll(".seat-box.seat-occupied, .seat-box.seat-reserved");
                occupiedSeats.forEach(seat => {
                    seat.addEventListener("click", function() {
                        const seatNum = parseInt(this.getAttribute("data-seat"));
                        const vta = ventasActivasData.find(v => v.numeroAsiento === seatNum);

                        if (vta) {
                            document.getElementById("modalAsientoNumero").innerText = vta.numeroAsiento;
                            document.getElementById("modalAsientoEstado").innerText = vta.estado;
                            document.getElementById("modalPasajeroNombre").innerText = vta.nombrePasajero;
                            document.getElementById("modalPasajeroDoc").innerText = vta.docPasajero;
                            document.getElementById("modalPasajeroComp").innerText = `${vta.comprobante} | S/ ${vta.precio}`;
                            document.getElementById("modalIdVentaInput").value = vta.idVenta;

                            const btnTicket = document.getElementById("modalVerTicketLink");
                            if (btnTicket) {
                                btnTicket.href = `/Venta/Ticket/${vta.idVenta}`;
                            }

                            const modalEl = document.getElementById("modalDetalleAsientoOcupado");
                            if (modalEl) {
                                const bsModal = new bootstrap.Modal(modalEl);
                                bsModal.show();
                            }
                        }
                    });
                });

                // Handle seat clicks (multi-selection for available seats)
                seats.forEach(seat => {
                    seat.addEventListener("click", function() {
                        const seatNum = parseInt(this.getAttribute("data-seat"));
                        if (selectedSeatsList.includes(seatNum)) {
                            selectedSeatsList = selectedSeatsList.filter(s => s !== seatNum);
                            this.classList.remove("seat-selected");
                        } else {
                            selectedSeatsList.push(seatNum);
                            this.classList.add("seat-selected");
                        }
                        updatePassengerFormRows();
                    });
                });

                window.consultarDocAsiento = async function(seatNum) {
                    const tipo = document.getElementById(`tipoDoc_${seatNum}`).value;
                    const numero = document.getElementById(`numDoc_${seatNum}`).value.trim();
                    const nombreInput = document.getElementById(`nombre_${seatNum}`);

                    if (!numero) {
                        alert("Por favor, ingrese un número de documento.");
                        return;
                    }

                    try {
                        const response = await fetch(`/Documento/Consultar?tipo=${tipo}&numero=${numero}`);
                        const data = await response.json();

                        if (data.success) {
                            nombreInput.value = data.nombreCompleto;
                        } else {
                            alert(data.mensaje || "No se encontraron datos para este documento. Ingrese el nombre manualmente.");
                        }
                    } catch (error) {
                        console.error("Error al consultar documento: ", error);
                        alert("Ocurrió un error al consultar el documento. Complete el nombre manualmente.");
                    }
                };

                // Invoicing / Comprobante switcher
                const tipoComprobante = document.getElementById("tipoComprobante");
                const seccionFactura = document.getElementById("seccionFactura");
                const rucEmpresa = document.getElementById("rucEmpresa");
                const razonSocialEmpresa = document.getElementById("razonSocialEmpresa");

                tipoComprobante.addEventListener("change", function() {
                    if (this.value === "Factura") {
                        seccionFactura.classList.remove("d-none");
                        rucEmpresa.setAttribute("required", "true");
                        razonSocialEmpresa.setAttribute("required", "true");
                    } else {
                        seccionFactura.classList.add("d-none");
                        rucEmpresa.removeAttribute("required");
                        razonSocialEmpresa.removeAttribute("required");
                    }
                });

                // Sunat RUC lookup
                const btnConsultarRuc = document.getElementById("btnConsultarRuc");
                const btnRucText = document.getElementById("btnRucText");
                const btnRucSpinner = document.getElementById("btnRucSpinner");
                const direccionEmpresa = document.getElementById("direccionEmpresa");

                btnConsultarRuc.addEventListener("click", async function() {
                    const numero = rucEmpresa.value.trim();

                    if (!numero || numero.length !== 11) {
                        alert("Debe ingresar un número de RUC válido de 11 dígitos.");
                        return;
                    }

                    btnRucText.classList.add("d-none");
                    btnRucSpinner.classList.remove("d-none");
                    btnConsultarRuc.setAttribute("disabled", "true");

                    try {
                        const response = await fetch(`/Documento/Consultar?tipo=RUC&numero=${numero}`);
                        const data = await response.json();

                        if (data.success) {
                            razonSocialEmpresa.value = data.nombreCompleto;
                            if (data.direccion && direccionEmpresa) {
                                direccionEmpresa.value = data.direccion;
                            }
                        } else {
                            alert(data.mensaje || "No se encontraron datos para este RUC. Complete los datos manualmente.");
                        }
                    } catch (error) {
                        console.error("Error al consultar RUC: ", error);
                        alert("Ocurrió un error al consultar el RUC. Complete los datos de forma manual.");
                    } finally {
                        btnRucText.classList.remove("d-none");
                        btnRucSpinner.classList.add("d-none");
                        btnConsultarRuc.removeAttribute("disabled");
                    }
                });

                // Discount logic
                const btnAplicarDescuento = document.getElementById("btnAplicarDescuento");
                const descuentoInput = document.getElementById("descuentoInput");

                btnAplicarDescuento.addEventListener("click", function() {
                    const discountVal = parseFloat(descuentoInput.value) || 0;
                    if (discountVal < 0) {
                        alert("El descuento no puede ser negativo.");
                        return;
                    }
                    alert("Descuento registrado.");
                });

                // Handle submits
                const ventaForm = document.getElementById("ventaForm");
                const tipoTransaccionInput = document.getElementById("tipoTransaccionInput");

                // Smooth scroll directly to booking section
                if (bookingSection) {
                    setTimeout(function() {
                        bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }

                btnVenderSubmit.addEventListener("click", function() {
                    if (selectedSeatsList.length === 0) {
                        alert("Por favor, seleccione al menos un asiento libre.");
                        return;
                    }
                    tipoTransaccionInput.value = "Venta";
                    ventaForm.submit();
                });

                btnReservarSubmit.addEventListener("click", function() {
                    if (selectedSeatsList.length === 0) {
                        alert("Por favor, seleccione al menos un asiento libre.");
                        return;
                    }
                    tipoTransaccionInput.value = "Reserva";
                    ventaForm.submit();
                });
            }
        });
    </script>
}

