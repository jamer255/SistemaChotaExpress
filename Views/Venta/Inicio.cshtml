@{
    ViewData["Title"] = "Bienvenido";
    var nombre = TempData["BienvenidaLogin"]?.ToString() ?? User.Identity?.Name ?? "Trabajador";
    var hora   = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    var emoji  = hora < 12 ? "🌅" : hora < 19 ? "☀️" : "🌙";
    var rol    = User.IsInRole("Gerente") ? "Administrador / Gerente" : "Vendedor de Agencia";
}

<style>
    /* En la página de inicio, ocultar los links repetidos en la barra superior */
    .navbar .navbar-nav.me-auto > .nav-item:not(:first-child) {
        display: none !important;
    }

    .inicio-dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
    }

    /* Hero Branding */
    .hero-brand-section {
        text-align: center;
        margin-bottom: 2.2rem;
        position: relative;
    }

    .hero-logo-img {
        max-width: 290px;
        height: auto;
        border-radius: 14px;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 8px 24px rgba(243, 112, 33, 0.2), 0 2px 8px rgba(0,0,0,0.1);
        display: inline-block;
        margin-bottom: 1.2rem;
        transition: transform 0.3s ease;
    }
    .hero-logo-img:hover {
        transform: scale(1.02);
    }

    .nombre-glow {
        background: linear-gradient(90deg, #f37021 0%, #fbbf24 50%, #f37021 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s linear infinite;
        font-weight: 900;
    }
    @@keyframes gradientShift {
        to { background-position: 200% center; }
    }

    .badge-saludo {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 99px;
        background: rgba(243, 112, 33, 0.12);
        border: 1px solid rgba(243, 112, 33, 0.3);
        color: #f37021;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    /* Combi Showcase Banner */
    .combi-hero-card {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(243, 112, 33, 0.3);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        margin-bottom: 2.5rem;
        background: #0f172a;
    }
    .combi-hero-img {
        width: 100%;
        height: 270px;
        object-fit: cover;
        object-position: center 65%;
        display: block;
        transition: transform 0.5s ease;
    }
    .combi-hero-card:hover .combi-hero-img {
        transform: scale(1.02);
    }
    .combi-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(10, 14, 26, 0.95) 0%, rgba(10, 14, 26, 0.4) 50%, transparent 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.5rem 2rem;
    }
    .combi-hero-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 6px;
    }
    .combi-chip {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 99px;
        border: 1px solid rgba(255, 255, 255, 0.25);
    }

    /* Tarjetas de Acciones Principales */
    .cards-section-title {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .cards-section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(243, 112, 33, 0.4), transparent);
    }

    .modulo-card {
        border-radius: 18px;
        padding: 1.5rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(30, 41, 59, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .modulo-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: transparent;
        transition: background 0.3s ease;
    }
    .modulo-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
        border-color: rgba(243, 112, 33, 0.4);
    }

    /* Colores temáticos por tarjeta */
    .modulo-card.card-pasajes-vender::before { background: linear-gradient(90deg, #f37021, #fb923c); }
    .modulo-card.card-pasajes-historial::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .modulo-card.card-encomiendas-registrar::before { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .modulo-card.card-encomiendas-historial::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .modulo-card.card-encomiendas-manifiesto::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

    .card-icon-box {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.65rem;
        margin-bottom: 1.1rem;
        transition: transform 0.3s ease;
    }
    .modulo-card:hover .card-icon-box {
        transform: scale(1.1) rotate(4deg);
    }

    .icon-orange { background: rgba(243, 112, 33, 0.15); color: #f37021; }
    .icon-green  { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .icon-blue   { background: rgba(2, 132, 199, 0.15); color: #0284c7; }
    .icon-amber  { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .icon-purple { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; }

    .card-badge-pill {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 6px;
        align-self: flex-start;
        margin-bottom: 0.4rem;
    }
    .badge-orange { background: rgba(243, 112, 33, 0.15); color: #f37021; }
    .badge-green  { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .badge-blue   { background: rgba(2, 132, 199, 0.15); color: #0284c7; }
    .badge-amber  { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .badge-purple { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; }

    .card-titulo {
        font-size: 1.05rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
    }
    .card-desc {
        font-size: 0.82rem;
        color: #94a3b8;
        line-height: 1.4;
        margin-bottom: 1.1rem;
        flex-grow: 1;
    }
    .card-action-link {
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: gap 0.2s ease;
    }
    .modulo-card:hover .card-action-link {
        gap: 10px;
    }

    /* Soporte para Modo Claro */
    [data-theme="light"] .modulo-card,
    body:not(.dark-mode) .modulo-card {
        background: #ffffff;
        border-color: #e2e8f0;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
    }
    [data-theme="light"] .card-titulo,
    body:not(.dark-mode) .card-titulo {
        color: #0f172a;
    }
    [data-theme="light"] .card-desc,
    body:not(.dark-mode) .card-desc {
        color: #64748b;
    }

    /* Animación de entrada */
    .fade-in-up {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.35s; }
    @@keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="inicio-dashboard-container">

    <!-- HERO BRANDING: LOGO OFICIAL & SALUDO -->
    <div class="hero-brand-section fade-in-up delay-1">
        <div>
            <img src="~/img/logo_chota.jpg" alt="Tours Chota Express S.A.C." class="hero-logo-img" />
        </div>
        
        <div class="badge-saludo">
            <span>@emoji</span>
            <span>@saludo</span>
            <span class="mx-1">•</span>
            <span>@rol</span>
        </div>

        <h1 class="display-6 fw-bold text-white mb-2">
            ¡Hola, <span class="nombre-glow">@nombre</span>!
        </h1>
        <p class="text-muted mx-auto" style="max-width: 600px; font-size: 0.95rem;">
            Bienvenido al sistema integrado de <strong class="text-white">Tours Chota Express</strong>. Selecciona un módulo operativo en las tarjetas a continuación para comenzar:
        </p>
    </div>

    <!-- SHOWCASE DE LA COMBI TOYOTA HIACE -->
    <div class="combi-hero-card fade-in-up delay-2">
        <img src="~/img/combi_inicio.jpg" alt="Combi Oficial Chota Express" class="combi-hero-img" />
        <div class="combi-hero-overlay">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2">
                <div>
                    <h3 class="text-white fw-bold mb-1" style="font-size: 1.35rem;">
                        <i class="fa-solid fa-van-shuttle text-warning me-2"></i>Flota Oficial Tours Chota Express S.A.C.
                    </h3>
                    <p class="text-light mb-2 small opacity-75">
                        Unidades Toyota HiAce modernas para el transporte seguro de pasajeros y encomiendas.
                    </p>
                    <div class="combi-hero-chips">
                        <span class="combi-chip"><i class="fa-solid fa-route me-1 text-warning"></i> Chota — Cajamarca — Cutervo</span>
                        <span class="combi-chip"><i class="fa-solid fa-shield-halved me-1 text-success"></i> Monitoreo SUTRAN & MTC</span>
                        <span class="combi-chip"><i class="fa-solid fa-bolt me-1 text-info"></i> Salidas Continuas</span>
                    </div>
                </div>
                <div class="text-md-end">
                    <span class="badge bg-success px-3 py-2 fs-8 shadow-sm">
                        <i class="fa-solid fa-circle-check me-1"></i> Sistema Operativo en Línea
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TÍTULO DE MÓDULOS -->
    <div class="cards-section-title fade-in-up delay-3">
        <i class="fa-solid fa-grid-2 me-1 text-warning"></i>
        <span>Módulos de Trabajo y Acciones Rápidas</span>
    </div>

    <!-- GRID DE TARJETAS (TODAS LAS OPCIONES DEL SISTEMA) -->
    <div class="row g-3 g-lg-4 justify-content-center fade-in-up delay-3">
        
        <!-- 1. VENDER PASAJES -->
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Venta" asp-action="BuscarViajes" class="modulo-card card-pasajes-vender">
                <div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-icon-box icon-orange">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                        <span class="card-badge-pill badge-orange">Módulo Principal</span>
                    </div>
                    <div class="card-titulo">Vender Pasajes</div>
                    <div class="card-desc">
                        Emisión de pasajes con croquis interactivo de asientos, asignación de turnos y registro rápido de pasajeros.
                    </div>
                </div>
                <div class="card-action-link text-warning">
                    <span>Ingresar a Venta</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 2. REGISTRO DE PASAJES VENDIDOS -->
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Venta" asp-action="MisVentas" class="modulo-card card-pasajes-historial">
                <div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-icon-box icon-green">
                            <i class="fa-solid fa-list-check"></i>
                        </div>
                        <span class="card-badge-pill badge-green">Historial Ventas</span>
                    </div>
                    <div class="card-titulo">Registro de Pasajes Vendidos</div>
                    <div class="card-desc">
                        Reporte y consulta de pasajes emitidos, reimpresión de boletos y detalle de ingresos por turno.
                    </div>
                </div>
                <div class="card-action-link text-success">
                    <span>Ver Registro de Pasajes</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 3. REGISTRAR ENCOMIENDAS -->
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Encomienda" asp-action="Registrar" class="modulo-card card-encomiendas-registrar">
                <div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-icon-box icon-blue">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <span class="card-badge-pill badge-blue">Nuevo Envío</span>
                    </div>
                    <div class="card-titulo">Registrar Encomiendas</div>
                    <div class="card-desc">
                        Recepción de paquetes, registro de remitente y consignatario, tarifas e impresión de guías de encomienda.
                    </div>
                </div>
                <div class="card-action-link text-info">
                    <span>Registrar Nueva Encomienda</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 4. REGISTRO DE ENCOMIENDAS -->
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Encomienda" asp-action="Index" class="modulo-card card-encomiendas-historial">
                <div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-icon-box icon-amber">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <span class="card-badge-pill badge-amber">Control Paquetes</span>
                    </div>
                    <div class="card-titulo">Registro de Encomiendas</div>
                    <div class="card-desc">
                        Listado completo de encomiendas recibidas, control de entregas, estados de envío y filtros por fecha.
                    </div>
                </div>
                <div class="card-action-link text-warning">
                    <span>Consultar Encomiendas</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 5. MANIFIESTO DE ENCOMIENDAS POR TURNO -->
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Encomienda" asp-action="ManifiestoTurno" class="modulo-card card-encomiendas-manifiesto">
                <div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-icon-box icon-purple">
                            <i class="fa-solid fa-clipboard-list"></i>
                        </div>
                        <span class="card-badge-pill badge-purple">Despacho de Carga</span>
                    </div>
                    <div class="card-titulo">Manifiesto de Encomiendas</div>
                    <div class="card-desc">
                        Generación del manifiesto oficial de encomiendas por combi y turno de salida para el conductor.
                    </div>
                </div>
                <div class="card-action-link" style="color: #a78bfa;">
                    <span>Generar Manifiesto</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

    </div>

    <!-- FOOTER INFORMACIÓN DE SESIÓN -->
    <div class="text-center mt-5 text-muted fade-in-up delay-3" style="font-size: 0.8rem;">
        <div>
            <i class="fa-regular fa-clock me-1 text-warning"></i>
            Sesión iniciada el <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong> a las <strong>@DateTime.Now.ToString("hh:mm tt")</strong>
        </div>
        <div class="mt-1 opacity-75">
            Tours Chota Express S.A.C. &copy; @DateTime.Now.Year — Transporte Interprovincial de Pasajeros y Carga
        </div>
    </div>

</div>
