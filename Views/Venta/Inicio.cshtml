@{
    ViewData["Title"] = "Bienvenido";
    var nombre = TempData["BienvenidaLogin"]?.ToString() ?? User.Identity?.Name ?? "Trabajador";
    // Hora oficial de Perú (UTC-5)
    var horaLocal = DateTime.UtcNow.AddHours(-5);
    var hora   = horaLocal.Hour;
    var saludo = (hora >= 5 && hora < 12) ? "Buenos días" : (hora >= 12 && hora < 19) ? "Buenas tardes" : "Buenas noches";
    var emoji  = (hora >= 5 && hora < 12) ? "🌅" : (hora >= 12 && hora < 19) ? "☀️" : "🌙";
    var rol    = User.IsInRole("Gerente") ? "Administrador" : "Vendedor de Agencia";
}

<style>
    /* En la página de inicio, ocultar los links repetidos en la barra superior */
    .navbar .navbar-nav.me-auto > .nav-item:not(:first-child) {
        display: none !important;
    }

    .inicio-dashboard-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
    }

    /* Hero Header: Logo Grande y Saludo */
    .hero-header-clean {
        text-align: center;
        margin-bottom: 2.2rem;
    }

    .hero-logo-badge {
        max-width: 310px;
        height: auto;
        border-radius: 16px;
        padding: 10px 22px;
        background: #ffffff;
        box-shadow: 0 8px 26px rgba(243, 112, 33, 0.2), 0 2px 8px rgba(0,0,0,0.08);
        display: inline-block;
        margin-bottom: 1.2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hero-logo-badge:hover {
        transform: scale(1.025);
        box-shadow: 0 12px 32px rgba(243, 112, 33, 0.28);
    }

    .nombre-glow {
        background: linear-gradient(90deg, #f37021 0%, #fbbf24 50%, #f37021 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s linear infinite;
        font-weight: 800;
    }
    @@keyframes gradientShift {
        to { background-position: 200% center; }
    }

    .badge-saludo-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 99px;
        background: rgba(243, 112, 33, 0.12);
        border: 1px solid rgba(243, 112, 33, 0.3);
        color: #f37021;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    /* Títulos de Categoría */
    .grid-section-label {
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #f37021;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .grid-section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(243, 112, 33, 0.35), transparent);
    }

    /* Tarjetas Uniformes */
    .modulo-card-unified {
        border-radius: 18px;
        padding: 1.5rem 1.4rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        min-height: 190px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(30, 41, 59, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.1);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .modulo-card-unified::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: transparent;
        transition: background 0.3s ease;
    }
    .modulo-card-unified:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.25);
        border-color: rgba(243, 112, 33, 0.45);
    }

    /* Variantes de color */
    .card-pasajes-vender::before    { background: linear-gradient(90deg, #f37021, #fb923c); }
    .card-pasajes-historial::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .card-encomienda-reg::before    { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .card-encomienda-hist::before   { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .card-encomienda-manif::before  { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

    .card-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .icon-box-sm {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        transition: transform 0.25s ease;
    }
    .modulo-card-unified:hover .icon-box-sm {
        transform: scale(1.1);
    }

    .icon-orange { background: rgba(243, 112, 33, 0.14); color: #f37021; }
    .icon-green  { background: rgba(16, 185, 129, 0.14); color: #10b981; }
    .icon-blue   { background: rgba(2, 132, 199, 0.14); color: #0284c7; }
    .icon-amber  { background: rgba(245, 158, 11, 0.14); color: #f59e0b; }
    .icon-purple { background: rgba(139, 92, 246, 0.14); color: #8b5cf6; }

    .pill-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 9px;
        border-radius: 6px;
    }
    .pill-orange { background: rgba(243, 112, 33, 0.15); color: #f37021; }
    .pill-green  { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .pill-blue   { background: rgba(2, 132, 199, 0.15); color: #0284c7; }
    .pill-amber  { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .pill-purple { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; }

    .card-title-text {
        font-size: 1.12rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
    }
    .card-desc-text {
        font-size: 0.84rem;
        color: #94a3b8;
        line-height: 1.4;
        margin-bottom: 1rem;
        flex-grow: 1;
    }
    .card-btn-action {
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: gap 0.2s ease;
    }
    .modulo-card-unified:hover .card-btn-action {
        gap: 10px;
    }

    /* Soporte para Modo Claro */
    [data-theme="light"] .modulo-card-unified,
    body:not(.dark-mode) .modulo-card-unified {
        background: #ffffff;
        border-color: #e2e8f0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
    [data-theme="light"] .card-title-text,
    body:not(.dark-mode) .card-title-text {
        color: #0f172a;
    }
    [data-theme="light"] .card-desc-text,
    body:not(.dark-mode) .card-desc-text {
        color: #64748b;
    }

    /* Animación de entrada */
    .fade-up-item {
        animation: fadeUpQuick 0.45s ease forwards;
        opacity: 0;
        transform: translateY(16px);
    }
    .d-1 { animation-delay: 0.05s; }
    .d-2 { animation-delay: 0.15s; }
    .d-3 { animation-delay: 0.25s; }
    @@keyframes fadeUpQuick {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="inicio-dashboard-container">

    <!-- HERO: LOGO OFICIAL GRANDE & SALUDO DINÁMICO POR HORA -->
    <div class="hero-header-clean fade-up-item d-1">
        <div>
            <img src="~/img/logo_chota.jpg?v=@DateTime.Now.Ticks" asp-append-version="true" alt="Tours Chota Express S.A.C." class="hero-logo-badge" />
        </div>
        <div class="badge-saludo-chip">
            <span>@emoji</span>
            <span>@saludo</span>
            <span>•</span>
            <span>@rol</span>
        </div>
        <h1 class="text-white fw-bold mb-1" style="font-size: clamp(1.6rem, 3.8vw, 2.5rem);">
            @saludo, <span class="nombre-glow">@nombre</span>
        </h1>
        <p class="text-muted small mb-0">
            Selecciona una acción operativa para comenzar:
        </p>
    </div>

    <!-- SECCIÓN 1: VENTA DE PASAJES (2 TARJETAS AMPLIAS) -->
    <div class="grid-section-label fade-up-item d-2">
        <i class="fa-solid fa-users text-warning"></i>
        <span>Venta y Control de Pasajes</span>
    </div>

    <div class="row g-3 g-lg-4 mb-4 fade-up-item d-2">
        
        <!-- 1. Vender Pasajes -->
        <div class="col-12 col-md-6">
            <a asp-controller="Venta" asp-action="BuscarViajes" class="modulo-card-unified card-pasajes-vender">
                <div>
                    <div class="card-top-row">
                        <div class="icon-box-sm icon-orange">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                        <span class="pill-badge pill-orange">Principal</span>
                    </div>
                    <div class="card-title-text">Vender Pasajes</div>
                    <div class="card-desc-text">
                        Emisión rápida de boletos con croquis interactivo de asientos en combi, selección de turno y registro de pasajero.
                    </div>
                </div>
                <div class="card-btn-action text-warning">
                    <span>Emitir pasajes</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 2. Registro de Pasajes Vendidos -->
        <div class="col-12 col-md-6">
            <a asp-controller="Venta" asp-action="MisVentas" class="modulo-card-unified card-pasajes-historial">
                <div>
                    <div class="card-top-row">
                        <div class="icon-box-sm icon-green">
                            <i class="fa-solid fa-list-check"></i>
                        </div>
                        <span class="pill-badge pill-green">Historial</span>
                    </div>
                    <div class="card-title-text">Registro de Pasajes Vendidos</div>
                    <div class="card-desc-text">
                        Consulta general de boletos emitidos, búsqueda por DNI o fecha, reimpresión y control de ventas por turno.
                    </div>
                </div>
                <div class="card-btn-action text-success">
                    <span>Ver pasajes vendidos</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

    </div>

    <!-- SECCIÓN 2: ENCOMIENDAS & CARGA (3 TARJETAS ALINEADAS) -->
    <div class="grid-section-label fade-up-item d-3">
        <i class="fa-solid fa-boxes-stacked text-info"></i>
        <span>Servicio de Encomiendas & Carga</span>
    </div>

    <div class="row g-3 g-lg-4 mb-4 fade-up-item d-3">

        <!-- 3. Registrar Encomiendas -->
        <div class="col-12 col-md-4">
            <a asp-controller="Encomienda" asp-action="Registrar" class="modulo-card-unified card-encomienda-reg">
                <div>
                    <div class="card-top-row">
                        <div class="icon-box-sm icon-blue">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <span class="pill-badge pill-blue">Recepción</span>
                    </div>
                    <div class="card-title-text">Registrar Encomiendas</div>
                    <div class="card-desc-text">
                        Recepción de nuevos paquetes, registro de remitente y destinatario, tarifas y emisión de guías.
                    </div>
                </div>
                <div class="card-btn-action text-info">
                    <span>Nuevo paquete</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 4. Registro de Encomiendas -->
        <div class="col-12 col-md-4">
            <a asp-controller="Encomienda" asp-action="Index" class="modulo-card-unified card-encomienda-hist">
                <div>
                    <div class="card-top-row">
                        <div class="icon-box-sm icon-amber">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <span class="pill-badge pill-amber">Control</span>
                    </div>
                    <div class="card-title-text">Registro de Encomiendas</div>
                    <div class="card-desc-text">
                        Listado completo de paquetes recibidos, seguimiento de envíos y control de entregas.
                    </div>
                </div>
                <div class="card-btn-action text-warning">
                    <span>Historial de envíos</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- 5. Manifiesto de Encomiendas por Turno -->
        <div class="col-12 col-md-4">
            <a asp-controller="Encomienda" asp-action="ManifiestoTurno" class="modulo-card-unified card-encomienda-manif">
                <div>
                    <div class="card-top-row">
                        <div class="icon-box-sm icon-purple">
                            <i class="fa-solid fa-clipboard-list"></i>
                        </div>
                        <span class="pill-badge pill-purple">Despacho</span>
                    </div>
                    <div class="card-title-text">Manifiesto por Turno</div>
                    <div class="card-desc-text">
                        Generación e impresión oficial de la hoja de ruta y carga de encomiendas por combi de salida.
                    </div>
                </div>
                <div class="card-btn-action" style="color: #a78bfa;">
                    <span>Generar manifiesto</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>
        </div>

    </div>

    <!-- FOOTER INFORMACIÓN DE SESIÓN -->
    <div class="text-center pt-3 text-muted fade-up-item d-3" style="font-size: 0.8rem;">
        <div>
            <i class="fa-regular fa-clock me-1 text-warning"></i>
            Sesión iniciada el <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong> a las <strong>@DateTime.Now.ToString("hh:mm tt")</strong>
        </div>
        <div class="opacity-75 mt-1">
            Tours Chota Express S.A.C. &copy; @DateTime.Now.Year — Transporte Interprovincial de Pasajeros y Carga
        </div>
    </div>

</div>
