@model SistemaChotaExpress.Models.Viaje
@{
    Layout = null;
    var ventas = ViewBag.VentasActivas as List<SistemaChotaExpress.Models.Venta> ?? new List<SistemaChotaExpress.Models.Venta>();
    var vendidosCount = ventas.Count(v => v.Estado == "Vendido");
    var reservadosCount = ventas.Count(v => v.Estado == "Reservado");
    var totalOcupados = vendidosCount + reservadosCount;
    var capacidad = Model.ObjetoBus?.Capacidad ?? 15;
    var libresCount = capacidad - totalOcupados;
    if (libresCount < 0) libresCount = 0;

    var destinoUpper = Model.ObjetoRuta?.Destino?.ToUpper() ?? "";
    bool esRutaCutervo = destinoUpper.Contains("CUTERVO");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manifiesto de Pasajeros - Salida #@Model.Id_Viaje - Chota Express</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@page {
            size: A4 portrait;
            margin: 6mm 8mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #e2e8f0;
            color: #000000;
            margin: 0;
            padding: 15px;
            font-size: 11px;
        }

        /* Barra superior interactiva (No imprimible) */
        .no-print {
            max-width: 210mm;
            margin: 0 auto 12px auto;
            background: #1e293b;
            color: #ffffff;
            padding: 12px 18px;
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        }

        /* Hoja A4 Oficial */
        .a4-sheet {
            width: 210mm;
            min-height: 297mm;
            max-width: 100%;
            margin: 0 auto;
            background: #ffffff;
            padding: 10mm 12mm;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            border: 1px solid #94a3b8;
            position: relative;
        }

        /* Encabezado */
        .manifest-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 6px;
            margin-bottom: 6px;
        }

        .header-left {
            flex: 1;
            padding-right: 15px;
        }

        .company-title {
            font-size: 13.5pt;
            font-weight: 900;
            color: #1e3a8a;
            letter-spacing: -0.2px;
            margin: 0 0 2px 0;
            text-transform: uppercase;
        }

        .company-subtitle {
            font-size: 7pt;
            color: #334155;
            line-height: 1.25;
            margin: 0;
        }

        .header-right {
            text-align: right;
            min-width: 230px;
        }

        .ruc-badge {
            font-size: 11pt;
            font-weight: 800;
            color: #1e3a8a;
            margin-bottom: 2px;
        }

        .doc-title {
            font-size: 13pt;
            font-weight: 900;
            color: #1e3a8a;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .serie-numero {
            font-size: 13pt;
            font-weight: 800;
            color: #dc2626;
            letter-spacing: 1px;
            margin-top: 2px;
            font-family: 'Courier New', Courier, monospace;
        }

        /* Franja de Permiso de Ruta */
        .route-banner {
            border: 1.5px solid #1e3a8a;
            background-color: #eff6ff;
            color: #1e3a8a;
            text-align: center;
            font-size: 8.5pt;
            font-weight: 800;
            padding: 4px 6px;
            letter-spacing: 0.3px;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        /* Cajas de Datos Técnicos (3 columnas) */
        .tech-data-row {
            display: flex;
            gap: 6px;
            margin-bottom: 6px;
        }

        .tech-box {
            flex: 1;
            border: 1.2px solid #1e3a8a;
            border-radius: 4px;
            display: flex;
            overflow: hidden;
            height: 96px;
        }

        .tech-box-side-label {
            background-color: #1e3a8a;
            color: #ffffff;
            font-size: 7.5pt;
            font-weight: 800;
            width: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 4px 0;
        }

        .tech-box-content {
            flex: 1;
            padding: 4px 6px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-size: 7.5pt;
        }

        .tech-field {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px dashed #cbd5e1;
            padding: 1.5px 0;
        }

        .tech-field:last-child {
            border-bottom: none;
        }

        .tech-label {
            font-weight: 800;
            color: #1e3a8a;
            font-size: 7pt;
        }

        .tech-val {
            font-weight: 700;
            color: #000000;
            text-align: right;
            font-size: 7.5pt;
        }

        /* Sección Tripulación */
        .crew-section {
            border: 1.2px solid #1e3a8a;
            border-radius: 4px;
            margin-bottom: 6px;
            overflow: hidden;
        }

        .crew-header {
            background-color: #1e3a8a;
            color: #ffffff;
            text-align: center;
            font-weight: 800;
            font-size: 8.5pt;
            letter-spacing: 2px;
            padding: 2px 0;
            text-transform: uppercase;
        }

        .crew-body {
            display: flex;
            padding: 4px 10px;
            font-size: 8pt;
            background: #ffffff;
        }

        .crew-pilot {
            flex: 2;
            display: flex;
            gap: 6px;
        }

        .crew-license {
            flex: 1;
            display: flex;
            gap: 6px;
            border-left: 1px dashed #cbd5e1;
            padding-left: 12px;
        }

        /* Tabla de Pasajeros */
        .passenger-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7.8pt;
            border: 1.5px solid #1e3a8a;
            margin-bottom: 8px;
        }

        .passenger-table th {
            background-color: #1e3a8a;
            color: #ffffff;
            font-weight: 800;
            text-transform: uppercase;
            padding: 4px 4px;
            border: 1px solid #1e3a8a;
            text-align: center;
            font-size: 7.5pt;
        }

        .passenger-table td {
            padding: 3.5px 4px;
            border: 1px solid #cbd5e1;
            vertical-align: middle;
            height: 24px;
        }

        .passenger-table tr:nth-child(even) td {
            background-color: #f8fafc;
        }

        .col-num { width: 26px; text-align: center; font-weight: 800; color: #1e3a8a; }
        .col-name { width: 38%; font-weight: 700; text-transform: uppercase; }
        .col-doc { width: 14%; text-align: center; font-family: monospace; font-size: 8pt; }
        .col-ticket { width: 12%; text-align: center; font-family: monospace; font-size: 7.5pt; }
        .col-seat { width: 10%; text-align: center; font-weight: 800; }
        .col-price { width: 10%; text-align: right; font-weight: 700; }
        .col-obs { width: 16%; font-size: 7pt; }

        /* Pie de página oficial */
        .manifest-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 6px;
            padding-top: 4px;
            font-size: 6.5pt;
            color: #475569;
        }

        .print-legend {
            font-size: 6pt;
            color: #64748b;
            text-transform: uppercase;
            max-width: 80%;
            line-height: 1.2;
        }

        .copy-tag {
            font-weight: 900;
            font-size: 9pt;
            color: #dc2626;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Ajustes de Impresión Estrictos A4 */
        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .no-print {
                display: none !important;
            }

            .a4-sheet {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                width: 100% !important;
                min-height: auto !important;
            }

            .route-banner {
                background-color: #eff6ff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .tech-box-side-label, .crew-header, .passenger-table th {
                background-color: #1e3a8a !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .passenger-table tr:nth-child(even) td {
                background-color: #f8fafc !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .serie-numero, .copy-tag {
                color: #dc2626 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>

    <!-- BARRA DE CONTROL Y ACCIONES (NO IMPRIMIBLE) -->
    <div class="no-print">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-warning"><i class="fa-solid fa-file-lines me-2"></i>Manifiesto Oficial de Pasajeros (Formato A4)</h5>
                <span class="text-white-50 small">Selecciona el permiso de ruta oficial para imprimir o compartir:</span>
            </div>
            
            <!-- Selector de Permiso de Ruta -->
            <div class="d-flex align-items-center gap-2">
                <span class="small fw-bold text-white"><i class="fa-solid fa-route text-warning me-1"></i>Ruta Oficial:</span>
                <div class="btn-group" role="group">
                    <button type="button" id="btnRutaCutervo" class="btn btn-sm @(esRutaCutervo ? "btn-warning text-dark fw-bold" : "btn-outline-light")" onclick="cambiarRutaPermiso('cutervo')">
                        <i class="fa-solid fa-check-circle me-1"></i> Hasta Cutervo
                    </button>
                    <button type="button" id="btnRutaChota" class="btn btn-sm @(!esRutaCutervo ? "btn-warning text-dark fw-bold" : "btn-outline-light")" onclick="cambiarRutaPermiso('chota')">
                        <i class="fa-solid fa-check-circle me-1"></i> Hasta Chota
                    </button>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="d-flex gap-2">
                <button onclick="window.print();" class="btn btn-warning fw-bold text-dark px-3 shadow-sm">
                    <i class="fa-solid fa-print me-1"></i> Imprimir en Hoja A4
                </button>
                <button onclick="enviarWhatsApp();" class="btn btn-success fw-bold px-3 shadow-sm">
                    <i class="fa-brands fa-whatsapp me-1"></i> Enviar a WhatsApp
                </button>
                <button onclick="window.close();" class="btn btn-outline-light px-3">
                    <i class="fa-solid fa-xmark me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>

    <!-- DOCUMENTO FÍSICO OFICIAL EN HOJA A4 -->
    <div class="a4-sheet">
        
        <!-- 1. ENCABEZADO FISCAL -->
        <div class="manifest-header">
            <div class="header-left">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-van-shuttle text-primary fs-3"></i>
                    <h1 class="company-title">EMPRESA DE MULTISERVICIOS Y TRANSPORTES TURS CHOTA EXPRESS S.A.C.</h1>
                </div>
                <div class="company-subtitle mt-1">
                    <strong>DOMICILIO FISCAL:</strong> Cal. Sara Macdougall N° 218 - Bar. San José - Cajamarca - Cajamarca - Cajamarca<br />
                    <strong>CAJAMARCA:</strong> JR. ANGAMOS N° 970 - TELF.: 076-267458 CEL.: 951314266 - CAJAMARCA<br />
                    <strong>CUTERVO:</strong> JR. COMERCIO N° 1116 - CUTERVO &nbsp;|&nbsp; <strong>CHOTA:</strong> JR. GREGORIO MALCA N° 445 - CHOTA
                </div>
            </div>
            <div class="header-right">
                <div class="ruc-badge">R.U.C. 20600308883</div>
                <div class="doc-title">MANIFIESTO DE PASAJEROS</div>
                <div class="serie-numero">0002 - Nº @Model.Id_Viaje.ToString("D6")</div>
            </div>
        </div>

        <!-- 2. FRANJA DE RUTA AUTORIZADA (INTERCAMBIABLE) -->
        <div class="route-banner" id="bannerRutaPermiso">
            @(esRutaCutervo
                ? "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA - CUTERVO Y VICIVERSA"
                : "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA Y VICIVERSA")
        </div>

        <!-- 3. CUADROS TÉCNICOS (RUTA / COMBI / CAPACIDAD) -->
        <div class="tech-data-row">
            
            <!-- Cuadro 1: RUTA -->
            <div class="tech-box">
                <div class="tech-box-side-label">R u t a</div>
                <div class="tech-box-content">
                    <div class="tech-field">
                        <span class="tech-label">ORIGEN:</span>
                        <span class="tech-val">@(Model.ObjetoRuta?.Origen.ToUpper() ?? "CAJAMARCA")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">DESTINO:</span>
                        <span class="tech-val" id="valDestinoManifiesto">@(Model.ObjetoRuta?.Destino.ToUpper() ?? "CHOTA")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">N° RES.:</span>
                        <span class="tech-val">001-2024-DRTC</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">FECHA:</span>
                        <span class="tech-val">@Model.FechaHoraSalida.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">HORA:</span>
                        <span class="tech-val">@Model.FechaHoraSalida.ToString("hh:mm tt")</span>
                    </div>
                </div>
            </div>

            <!-- Cuadro 2: COMBI -->
            <div class="tech-box">
                <div class="tech-box-side-label">C o m b i</div>
                <div class="tech-box-content">
                    <div class="tech-field">
                        <span class="tech-label">CÓDIGO:</span>
                        <span class="tech-val">@(Model.ObjetoBus != null ? $"BUS-{Model.ObjetoBus.Id_Bus:D2}" : "COMBI-01")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">MODELO:</span>
                        <span class="tech-val">@(Model.ObjetoBus?.Modelo ?? "Toyota HiAce")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">PLACA:</span>
                        <span class="tech-val font-monospace">@(string.IsNullOrWhiteSpace(Model.PlacaVehiculo) ? (Model.ObjetoBus?.Placa ?? "SIN PLACA") : Model.PlacaVehiculo.ToUpper())</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">MARCA:</span>
                        <span class="tech-val">@(Model.ObjetoBus?.Marca ?? "Toyota")</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">ESTADO:</span>
                        <span class="tech-val">OPERATIVO</span>
                    </div>
                </div>
            </div>

            <!-- Cuadro 3: CAPACIDAD -->
            <div class="tech-box">
                <div class="tech-box-side-label">C a p a c i d a d</div>
                <div class="tech-box-content">
                    <div class="tech-field">
                        <span class="tech-label">CAPACIDAD COMBI:</span>
                        <span class="tech-val">@capacidad</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">N° PASAJEROS OFICINA:</span>
                        <span class="tech-val">@vendidosCount</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">N° TRIPULACIÓN:</span>
                        <span class="tech-val">1</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">N° PASAJEROS RUTA:</span>
                        <span class="tech-val">0</span>
                    </div>
                    <div class="tech-field">
                        <span class="tech-label">ASIENTOS LIBRES:</span>
                        <span class="tech-val">@libresCount</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- 4. TRIPULACIÓN -->
        <div class="crew-section">
            <div class="crew-header">TRIPULACIÓN</div>
            <div class="crew-body">
                <div class="crew-pilot">
                    <strong class="text-primary">Piloto:</strong>
                    <span class="fw-bold text-uppercase">
                        @(string.IsNullOrWhiteSpace(Model.NombreConductor) ? (Model.ObjetoBus?.NombreConductor ?? "POR ASIGNAR") : Model.NombreConductor.ToUpper())
                    </span>
                </div>
                <div class="crew-license">
                    <strong class="text-primary">N° Licencia:</strong>
                    <span class="font-monospace fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.ObjetoBus?.NumeroLicencia) ? "POR ASIGNAR" : Model.ObjetoBus.NumeroLicencia.ToUpper())
                    </span>
                </div>
            </div>
        </div>

        <!-- 5. TABLA OFICIAL DE 16 PASAJEROS (SIN CROQUIS) -->
        <table class="passenger-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th class="col-name">PASAJERO</th>
                    <th class="col-doc">N° Doc.</th>
                    <th class="col-ticket">N° Pasaje</th>
                    <th class="col-seat">Asiento</th>
                    <th class="col-price">Precio</th>
                    <th class="col-obs">Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @{
                    // Renderizamos exactamente 16 filas como en el talonario físico
                    for (int i = 1; i <= 16; i++)
                    {
                        var vta = (ventas != null && i <= ventas.Count) ? ventas[i - 1] : null;

                        if (vta != null)
                        {
                            var pasName = vta.ObjetoPasajero?.NombreCompleto ?? "Pasajero";
                            var numDoc = vta.ObjetoPasajero?.NumeroDocumento ?? "-";
                            var ticketNum = $"#P-{vta.Id_Venta:D5}";
                            var asiento = $"#{vta.NumeroAsiento}";
                            var precio = $"S/ {vta.PrecioPagado:0.00}";
                            var obs = vta.Estado == "Reservado" ? "RESERVA" : "";
                            if (!string.IsNullOrWhiteSpace(vta.Observaciones))
                            {
                                obs = string.IsNullOrEmpty(obs) ? vta.Observaciones : $"{obs} - {vta.Observaciones}";
                            }

                            <tr>
                                <td class="col-num">@i</td>
                                <td class="col-name">@pasName</td>
                                <td class="col-doc">@numDoc</td>
                                <td class="col-ticket">@ticketNum</td>
                                <td class="col-seat">@asiento</td>
                                <td class="col-price">@precio</td>
                                <td class="col-obs">@obs</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td class="col-num">@i</td>
                                <td class="col-name text-muted">&nbsp;</td>
                                <td class="col-doc">&nbsp;</td>
                                <td class="col-ticket">&nbsp;</td>
                                <td class="col-seat">&nbsp;</td>
                                <td class="col-price">&nbsp;</td>
                                <td class="col-obs">&nbsp;</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        <!-- 6. PIE DE PÁGINA OFICIAL -->
        <div class="manifest-footer">
            <div class="print-legend">
                IMPRENTA GRAFICER UNIVERSA EIRL CALLE MANUEL SEOANE N° 173 - CAJAMARCA - RUC: 20604621004, AUT. 3041990163, N° SERIE: 0002, DEL 6001 AL 6750 - FECHA: 18/06/2026
            </div>
            <div class="copy-tag">
                USUARIO
            </div>
        </div>

    </div>

    <!-- SCRIPTS INTERACTIVOS (CAMBIO DE RUTA Y WHATSAPP) -->
    <script>
        // Función para alternar el permiso entre Cutervo y Chota
        function cambiarRutaPermiso(tipo) {
            const banner = document.getElementById('bannerRutaPermiso');
            const btnCutervo = document.getElementById('btnRutaCutervo');
            const btnChota = document.getElementById('btnRutaChota');

            if (tipo === 'cutervo') {
                banner.innerText = "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA - CUTERVO Y VICIVERSA";
                btnCutervo.className = "btn btn-sm btn-warning text-dark fw-bold";
                btnChota.className = "btn btn-sm btn-outline-light";
            } else {
                banner.innerText = "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA Y VICIVERSA";
                btnChota.className = "btn btn-sm btn-warning text-dark fw-bold";
                btnCutervo.className = "btn btn-sm btn-outline-light";
            }
        }

        // Envío directo a WhatsApp sin ventanas emergentes de teléfono
        function enviarWhatsApp() {
            const rutaTexto = document.getElementById('bannerRutaPermiso').innerText.trim();
            
            let texto = "*EMPRESA DE TRANSPORTES TURS CHOTA EXPRESS S.A.C.*\n";
            texto += "*MANIFIESTO OFICIAL DE PASAJEROS*\n";
            texto += "--------------------------------------\n";
            texto += "*Permiso de Ruta:* " + rutaTexto + "\n";
            texto += "*📍 Origen:* @(Model.ObjetoRuta?.Origen.ToUpper()) ➔ *Destino:* @(Model.ObjetoRuta?.Destino.ToUpper())\n";
            texto += "*📅 Fecha:* @Model.FechaHoraSalida.ToString("dd/MM/yyyy") | *⏰ Hora:* @Model.FechaHoraSalida.ToString("hh:mm tt")\n";
            texto += "*🚐 Placa:* @(string.IsNullOrWhiteSpace(Model.PlacaVehiculo) ? (Model.ObjetoBus?.Placa ?? "SIN PLACA") : Model.PlacaVehiculo.ToUpper())\n";
            texto += "*👨‍✈️ Piloto:* @(string.IsNullOrWhiteSpace(Model.NombreConductor) ? (Model.ObjetoBus?.NombreConductor ?? "POR ASIGNAR") : Model.NombreConductor.ToUpper())\n";
            texto += "*🪪 N° Licencia:* @(Model.ObjetoBus?.NumeroLicencia ?? "—")\n";
            texto += "--------------------------------------\n";
            texto += "*RELACIÓN DE PASAJEROS:*\n";

            let hayPasajeros = false;

            @if (ventas != null && ventas.Any())
            {
                int k = 1;
                foreach (var v in ventas)
                {
                    var pName = v.ObjetoPasajero?.NombreCompleto ?? "Pasajero";
                    var pDoc = v.ObjetoPasajero?.NumeroDocumento ?? "-";
                    var est = v.Estado == "Reservado" ? " (Reserva)" : "";
                    <text>
                    texto += "@k. [Asiento #@v.NumeroAsiento] @pName - Doc: @pDoc (S/ @v.PrecioPagado.ToString("0.00"))@est\n";
                    hayPasajeros = true;
                    </text>
                    k++;
                }
            }

            if (!hayPasajeros) {
                texto += "Sin pasajeros registrados aún.\n";
            }

            texto += "--------------------------------------\n";
            var recaudadoStr = "@(ventas.Where(v => v.Estado == "Vendido").Sum(v => v.PrecioPagado).ToString("0.00"))";
            texto += "*Total Recaudado:* S/ " + recaudadoStr;

            const url = "https://api.whatsapp.com/send?text=" + encodeURIComponent(texto);
            window.open(url, "_blank");
        }
    </script>
</body>
</html>
