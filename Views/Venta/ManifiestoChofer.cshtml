    <!-- SCRIPTS INTERACTIVOS (CAMBIO DE RUTA Y WHATSAPP) -->
    <script>
        function cambiarRutaPermiso(tipo) {
            const banner = document.getElementById('bannerRutaPermiso');
            const btnCutervo = document.getElementById('btnRutaCutervo');
            const btnChota = document.getElementById('btnRutaChota');

            if (tipo === 'cutervo') {
                banner.innerText = "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA - CUTERVO Y VICIVERSA";
                btnCutervo.className = "btn btn-xs btn-warning text-dark fw-bold";
                btnChota.className = "btn btn-xs btn-outline-light";
            } else {
                banner.innerText = "CAJAMARCA - PORCON - EL COBRO - PUENTE PIEDRA - SAMANGAY - CHOTA Y VICIVERSA";
                btnChota.className = "btn btn-xs btn-warning text-dark fw-bold";
                btnCutervo.className = "btn btn-xs btn-outline-light";
            }
        }

        function enviarWhatsApp() {
            const rutaTexto = document.getElementById('bannerRutaPermiso').innerText.trim();
            const origenVal = document.getElementById('valOrigen').innerText.trim();
            const destinoVal = document.getElementById('valDestino').innerText.trim();
            const placaVal = document.getElementById('valPlaca').innerText.trim();
            const pilotoVal = document.getElementById('valPiloto').innerText.trim();
            const licenciaVal = document.getElementById('valLicencia').innerText.trim();

            let texto = "*EMPRESA DE TRANSPORTES TURS CHOTA EXPRESS S.A.C.*\n";
            texto += "*MANIFIESTO OFICIAL DE PASAJEROS*\n";
            texto += "--------------------------------------\n";
            texto += "*Permiso de Ruta:* " + rutaTexto + "\n";
            texto += "*📍 Origen:* " + origenVal + " ➔ *Destino:* " + destinoVal + "\n";
            texto += "*📅 Fecha:* @Model.FechaHoraSalida.ToString("dd/MM/yyyy") | *⏰ Hora:* @Model.FechaHoraSalida.ToString("hh:mm tt")\n";
            texto += "*🚐 Placa:* " + placaVal + "\n";
            texto += "*👨‍✈️ Piloto:* " + pilotoVal + "\n";
            texto += "*🪪 N° Licencia:* " + licenciaVal + "\n";
            texto += "--------------------------------------\n";
            texto += "*RELACIÓN DE PASAJEROS:*\n";

            let hayPasajeros = false;

            @if (ventas != null && ventas.Any())
            {
                int k = 1;
                foreach (var v in ventas)
                {
                    var pName = v.ObjetoPasajero?.NombreCompleto ?? "Pasajero";
                    var pDoc = v.ObjetoPasajero?.NumeroDocumento ?? "-";
                    var est = v.Estado == "Reservado" ? " (Reserva)" : "";
                    <text>
                    texto += "@k. [Asiento #@v.NumeroAsiento] @pName - Doc: @pDoc (S/ @v.PrecioPagado.ToString("0.00"))@est\n";
                    hayPasajeros = true;
                    </text>
                    k++;
                }
            }

            if (!hayPasajeros) {
                texto += "Sin pasajeros registrados aún.\n";
            }

            texto += "--------------------------------------\n";
            texto += "*Resumen:* @vendidosCount Vendidos | @reservadosCount Reservados | @libresCount Libres\n";
            var recaudadoStr = "@(ventas.Where(v => v.Estado == "Vendido").Sum(v => v.PrecioPagado).ToString("0.00"))";
            texto += "*Total Recaudado:* S/ " + recaudadoStr;

            const url = "https://api.whatsapp.com/send?text=" + encodeURIComponent(texto);
            window.open(url, "_blank");
        }
    </script>
