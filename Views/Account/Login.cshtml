@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Tours Chota Express</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #F37021;
            --primary-dark: #D45B12;
            --dark: #121214;
            --dark-card: rgba(30, 30, 35, 0.75);
            --border-glass: rgba(255, 255, 255, 0.08);
            --text-light: #E1E1E6;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0f0f11 0%, #1c1a24 100%);
            color: var(--text-light);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
            position: relative;
        }

        /* Abstract glowing blobs for premium feel */
        .glow-blob {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(243, 112, 33, 0.15) 0%, rgba(243, 112, 33, 0) 70%);
            border-radius: 50%;
            z-index: 0;
        }
        .blob-1 { top: -100px; right: -100px; }
        .blob-2 { bottom: -100px; left: -100px; }

        .login-container {
            width: 100%;
            max-width: 450px;
            padding: 20px;
            z-index: 10;
        }

        .login-card {
            background: var(--dark-card);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--border-glass);
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            box-shadow: 0 20px 45px rgba(243, 112, 33, 0.1);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-svg {
            width: 180px;
            margin-bottom: 10px;
        }

        .brand-subtitle {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #a8a8b2;
            font-weight: 500;
        }

        .form-floating {
            margin-bottom: 20px;
            position: relative;
        }

        .form-floating .form-control {
            background: rgba(20, 20, 25, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 12px;
            padding-left: 45px;
        }

        .form-floating .form-control:focus {
            background: rgba(20, 20, 25, 0.8);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(243, 112, 33, 0.15);
        }

        .form-floating label {
            color: #8d8d99;
            left: 35px;
            transition: all 0.2s ease;
        }

        .form-floating .form-control:focus ~ label,
        .form-floating .form-control:not(:placeholder-shown) ~ label {
            left: 10px;
            color: var(--primary);
        }

        .form-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #5d5d66;
            z-index: 4;
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .form-control:focus ~ .form-icon {
            color: var(--primary);
        }

        .btn-login {
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            color: white;
            padding: 14px;
            font-weight: 600;
            border-radius: 12px;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 10px;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 112, 33, 0.4);
            filter: brightness(1.1);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .text-danger {
            color: #f75a68 !important;
            font-size: 0.85rem;
            margin-bottom: 15px;
        }

        /* Demo credentials card */
        .demo-box {
            margin-top: 30px;
            background: rgba(243, 112, 33, 0.05);
            border: 1px dashed rgba(243, 112, 33, 0.25);
            border-radius: 12px;
            padding: 15px;
            font-size: 0.8rem;
            color: #c4c4cc;
        }
        
        .demo-box i {
            color: var(--primary);
        }

        .demo-title {
            font-weight: 600;
            margin-bottom: 5px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <div class="glow-blob blob-1"></div>
    <div class="glow-blob blob-2"></div>

    <div class="login-container">
        <div class="login-card">
            <div class="logo-container text-center mb-3">
                <img src="~/img/logo_oficial.png" alt="Tours Chota Express" style="max-height: 78px; max-width: 250px; width: auto; object-fit: contain; background: #ffffff; padding: 6px 14px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15);" />
                <div class="brand-subtitle mt-2">Control de Pasajes</div>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-floating">
                    <input type="text" class="form-control" id="username" name="username" placeholder="Usuario" required autocomplete="username">
                    <label for="username">Usuario</label>
                    <i class="fa-solid fa-user form-icon"></i>
                </div>

                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required autocomplete="current-password">
                    <label for="password">Contraseña</label>
                    <i class="fa-solid fa-lock form-icon"></i>
                </div>

                <button type="submit" class="btn btn-login">
                    INGRESAR <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                </button>
            </form>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
